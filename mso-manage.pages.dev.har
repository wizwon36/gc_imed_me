              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=ur27wGx5uVW9H%2Fmp1sj%2FFtkIwZIP2Q6gBNdMN1CdCnfo46nfGScK5%2F3v6ImdsJ%2BgOg%2FzflxvjnQyPFLkPYAyc%2FIl%2Bp7Sw9uOR36rny8oeOhT8Cbu2Yf6dpFh1Yf4Jd%2BNZjvo2iw2KA%3D%3D\"}]}"
