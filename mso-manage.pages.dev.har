            "text": "/**\n * auth.js\n * Supabase Auth 기반 인증 모듈.\n * - 로그인 / 회원가입 / 승인 대기 처리\n */\n\nwindow.auth = (function () {\n\n  // [추가] 모바일 기기(User-Agent)로 접속하면 데스크톱용 app.html(사이드바+iframe, ag-grid\n  // 표 등)이 아니라 하단탭 기반의 전용 모바일 셸(mobile/app.html)로 보낸다. localStorage\n  // 오버라이드로 예외를 둔다 — 모바일 셸에 \"데스크톱 버전으로 보기\" 링크를 눌렀을 때(태블릿에서\n  // 정밀 작업이 필요한 경우 등) 이 값이 세팅되어 계속 데스크톱을 쓸 수 있게 한다.\n  // [추가] \"데스크톱 버전으로 보기\" 오버라이드(mso-force-desktop)는 화면이 좁은 스마트폰에서는\n  // 절대 허용하지 않는다 — 태블릿처럼 화면이 넓은 기기는 정밀 작업이 필요할 때 계속 데스크톱을\n  // 쓸 수 있어야 하므로, 기기 종류(UA)가 아니라 \"실제 화면 폭\"으로 판단한다. 이 임계값(768px)은\n  // app.html의 진입 가드, mobile-shell.js의 버튼 노출 조건과 반드시 같게 맞춰야 한다.\n  // [수정] 일부 PC에서 화면폭이 충분히 넓은데도 모바일 화면으로 튕기는 문제가 보고됨 —\n  // 원인은 터치기기의 \"가로 회전으로 가드 우회\" 방지를 위해 넣은 min(width,height) 비교였다.\n  // 흔한 1366×768 해상도의 노트북/모니터는 브라우저 주소창·즐겨찾기바·확장 프로그램 툴바·\n  // OS 작업표시줄이 세로 폭을 갉아먹어서, 창을 최대화해도 실제 뷰포트 높이(innerHeight)가\n  // 768px보다 작아지는 경우가 흔하다 — 마우스로 쓰는 PC는 화면 \"폭\"만으로 판단해도 충분하고\n  // 오히려 그래야 안전하다. 회전 우회 방지가 필요한 건 터치가 주 입력수단인 기기(폰)뿐이므로,\n  // pointer:coarse(주 입력이 손가락)인 경우에만 높이까지 같이 보고, 마우스/트랙패드 기반\n  // PC는 폭만 본다.\n  function isNarrowScreen() {\n    try {\n      var isTouchPrimary = !!(window.matchMedia && window.matchMedia('(pointer: coarse)').matches);\n      if (isTouchPrimary) {\n        return Math.min(window.innerWidth, window.innerHeight) < 768;\n      }\n      return window.innerWidth < 768;\n    } catch (e) {\n      return true; // 판단 불가 시 안전하게 \"좁은 화면(모바일)\"로 취급\n    }\n  }\n  function isMobileDevice() {\n    try {\n      if (localStorage.getItem('mso-force-desktop') === '1' && !isNarrowScreen()) return false;\n    } catch (e) {}\n    try {\n      return /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);\n    } catch (e) {\n      return false;\n    }\n  }\n  function getLoginUrl() { return `${CONFIG.SITE_BASE_URL}/${isMobileDevice() ? 'mobile/index.html' : 'index.html'}`; }\n  function getAppUrl()   { return `${CONFIG.SITE_BASE_URL}/${isMobileDevice() ? 'mobile/app.html' : 'app.html'}`; }\n\n  function setMessage(message, type = '') {\n    const el = document.getElementById('authMessage');\n    if (!el) return;\n    el.textContent = message || '';\n    el.className = 'auth-message' + (type ? ` is-${type}` : '');\n  }\n\n  /* ── 세션 ─────────────────────────────────────── */\n\n  async function getSession() {\n    const { data: { session } } = await supabaseClient.auth.getSession();\n    if (!session) return null;\n\n    const { data: profile } = await supabaseClient\n      .from('user_profiles')\n      .select('*')\n      .eq('id', session.user.id)\n      .single();\n\n    return {\n      id:          session.user.id,\n      email:       session.user.email,\n      user_name:   profile?.user_name || session.user.email,\n      role:        profile?.role       || 'own_clinic',\n      clinic_code: profile?.clinic_code || '',\n      clinic_name: profile?.clinic_name || '',\n      team_code:   profile?.team_code   || '',\n      team_name:   profile?.team_name   || '',\n      team_group_code: profile?.team_group_code || '',\n      department:  profile?.department  || '',\n      active:      profile?.active      || 'N',\n      allowed_pages: profile?.allowed_pages || null,\n      page_perms:    profile?.page_perms    || null,\n      // [★추가] is_admin/is_signage_manager — role(scope)과는 별개인 \"진짜 담당자\" 플래그.\n      // 이 필드가 없으면 org.js의 별도 조회를 거치지 않는 한 currentUser.is_admin이\n      // 앱 어디서든 항상 undefined였다(select('*')로는 잡히지만 여기서 화이트리스트로\n      // 명시적으로 골라 반환하는 구조라 빠져있었음).\n      is_admin:            !!profile?.is_admin,\n      is_signage_manager:  !!profile?.is_signage_manager,\n      is_equipment_manager: !!profile?.is_equipment_manager,\n      is_qc_manager:        !!profile?.is_qc_manager,\n    };\n  }\n\n  async function clearSession() {\n    try {\n      await supabaseClient.auth.signOut({ scope: 'local' });\n    } catch(e) {\n      console.warn('[auth] signOut error:', e);\n    }\n    // 세션 키 직접 제거 (iframe 공유 키 포함) — 실제 세션은 sessionStorage에 있지만,\n    // localStorage 쪽도 혹시 모를 과거 데이터(이 변경 이전에 로그인했던 잔여분) 정리 차원에서 같이 지운다.\n    try {\n      sessionStorage.removeItem('maneasy-auth');\n      localStorage.removeItem('maneasy-auth');\n      // 유휴시간 활동 기록도 같이 지운다 — 안 지우면 다음에 다시 로그인했을 때\n      // \"로그아웃 시점\"의 오래된 활동 타임스탬프가 그대로 남아있어서, 유휴시간\n      // 체크 로직이 \"이미 1시간 넘게 유휴 상태였다\"고 착각해 로그인 직후 곧바로\n      // 다시 로그아웃시켜버리는 문제가 있었다(로그인이 가끔 튕기는 원인).\n      localStorage.removeItem('maneasy-last-activity');\n      // Supabase가 내부적으로 쓰는 키들도 제거 (세션 저장소가 sessionStorage로\n      // 바뀌었으니 그쪽도 같이 확인)\n      [localStorage, sessionStorage].forEach(function(store) {\n        Object.keys(store).forEach(function(k) {\n          if (k.startsWith('sb-') || k.startsWith('supabase')) {\n            store.removeItem(k);\n          }\n        });\n      });\n    } catch(e) {}\n  }\n\n  /* ── 인증 가드 ─────────────────────────────────── */\n\n  async function requireAuth() {\n    const { data: { session } } = await supabaseClient.auth.getSession();\n    if (!session) { location.replace(getLoginUrl()); return null; }\n\n    // 승인 여부 확인\n    const user = await getSession();\n    if (user && user.active !== 'Y') {\n      await clearSession();\n      location.replace(getLoginUrl() + '?pending=1');\n      return null;\n    }\n    return session;\n  }\n\n  async function requireAdmin() {\n    // [★주의] 여기서 말하는 admin은 role='all_clinic' — \"전체 의원 조회 scope\"라는 뜻이지\n    // \"시스템 관리자\"가 아니다. 실제 관리자/사인물 담당자 여부는 user_profiles.is_admin /\n    // is_signage_manager 플래그로 별도 판단한다 (가입신청·사인물신청 알림 메일 수신 대상 등).\n    const session = await getSession();\n    if (!session) { location.replace(getLoginUrl()); return null; }\n    if (session.active !== 'Y') {\n      await clearSession();\n      location.replace(getLoginUrl() + '?pending=1');\n      return null;\n    }\n    if (session.role !== 'all_clinic') {\n      alert('관리자 권한이 필요합니다.');\n      location.replace(getAppUrl());\n      return null;\n    }\n    return session;\n  }\n\n  /* ── 로그인 페이지 ─────────────────────────────── */\n\n  async function initLoginPage() {\n    // ?type=recovery — 비밀번호 재설정 링크 클릭 후 진입 (예전 방식: 해시에 access_token 포함).\n    // 이 체크는 반드시 세션 여부 판단보다 먼저 와야 한다 — 브라우저에 이미(다른 계정이든\n    // 만료됐든) 세션이 남아있으면, 아래 \"세션 있으면 앱으로 리다이렉트\" 로직이 재설정 링크의\n    // 해시(access_token 등)를 확인하기도 전에 앱으로 넘겨버려서 재설정이 무산되는 문제가 있었음.\n    const hashParams = new URLSearchParams(location.hash.slice(1));\n    const isRecovery = hashParams.get('type') === 'recovery';\n    // 재설정 링크가 만료됐거나(otp_expired) 이미 사용됐거나 무효한 경우, Supabase는\n    // type=recovery 대신 #error=access_denied&error_code=otp_expired&error_description=...\n    // 형태로 돌려보낸다. 이걸 별도로 감지하지 않으면 그냥 조용히 일반 로그인 화면으로\n    // 넘어가버려서 \"링크를 눌러도 계속 로그인 페이지로 튕긴다\"는 증상으로 보인다.\n    const linkError = hashParams.get('error') || hashParams.get('error_code');\n\n    // ?token_hash=...&type=recovery — 새 방식(권장). send-recovery-email 함수가 이제\n    // Supabase의 /verify 직행 링크(action_link) 대신 이 형태로 메일을 보낸다.\n    // action_link는 클릭(GET) 즉시 1회용 토큰을 소비해버리는데, 회사 메일의 보안\n    // 스캐너(Safe Links류)가 메일 도착 직후 링크를 자동으로 미리 열어보면서 토큰을 먼저\n    // 써버려서, 정작 사용자 본인이 클릭했을 땐 \"만료/무효\" 처리되는 문제가 실제로 있었다.\n    // (인증 로그에서 실사용자 IP가 아닌 마이크로소프트 대역 IP가 먼저 /verify를 호출해\n    //  성공 처리하고, 그 직후 실사용자 요청이 \"One-time token not found\"로 실패하는\n    //  패턴을 확인함.) token_hash 방식은 페이지 로딩 자체로는 아무것도 소비하지 않고,\n    // 사용자가 화면의 버튼을 직접 눌러야만 verifyOtp()가 호출되어 토큰이 소비되므로\n    // 자동 프리페치로는 무력화되지 않는다.\n    const searchParamsForRecovery = new URLSearchParams(location.search);\n    const recoveryTokenHash = searchParamsForRecovery.get('token_hash');\n    const isRecoveryPending = !!recoveryTokenHash && searchParamsForRecovery.get('type') === 'recovery';\n    const signupTokenHash = searchParamsForRecovery.get('token_hash');\n    const isSignupPending = !!signupTokenHash && searchParamsForRecovery.get('type') === 'signup';\n\n    // ?logout=1 이면 세션 체크 없이 바로 로그인 화면 표시 (루프 방지)\n    const urlParams = new URLSearchParams(location.search);\n    if (isRecovery || linkError || isRecoveryPending || isSignupPending) {\n      // 재설정 흐름(성공/만료/대기 모두) 중엔 기존 세션 유무와 상관없이 절대 앱으로 리다이렉트하지 않는다.\n    } else if (urlParams.get('logout') === '1') {\n      // URL 파라미터 제거 후 로그인 화면 유지\n      history.replaceState(null, '', location.pathname);\n    } else {\n      const { data: { session } } = await supabaseClient.auth.getSession();\n      if (session) {\n        const user = await getSession();\n        if (user && user.active !== 'Y') {\n          await clearSession();\n        } else {\n          location.replace(getAppUrl());\n          return;\n        }\n      }\n    }\n\n    // ?pending=1 → 승인 대기 메시지\n    const params = new URLSearchParams(location.search);\n    if (params.get('pending') === '1') {\n      setMessage('계정 승인 대기 중입니다. 관리자 승인 후 로그인할 수 있습니다.', 'warn');\n    }\n\n    // 탭 전환 (로그인 / 회원가입 / 비밀번호 재설정)\n    const tabLogin    = document.getElementById('tabLogin');\n    const tabSignup   = document.getElementById('tabSignup');\n    const tabReset    = document.getElementById('tabReset');\n    const panelLogin  = document.getElementById('panelLogin');\n    const panelSignup = document.getElementById('panelSignup');\n    const panelReset  = document.getElementById('panelReset');\n    const resetStep0  = document.getElementById('resetStep0');\n    const resetStep1  = document.getElementById('resetStep1');\n    const resetStep2  = document.getElementById('resetStep2');\n    const panelSignupConfirm = document.getElementById('panelSignupConfirm');\n\n    function showTab(tab) {\n      [tabLogin, tabSignup, tabReset].forEach(t => t?.classList.remove('is-active'));\n      [panelLogin, panelSignup, panelReset, panelSignupConfirm].forEach(p => { if (p) p.style.display = 'none'; });\n      if (tab === 'login')  { tabLogin?.classList.add('is-active');  if (panelLogin)  panelLogin.style.display  = ''; }\n      if (tab === 'signup') { tabSignup?.classList.add('is-active'); if (panelSignup) panelSignup.style.display = ''; }\n      if (tab === 'reset')  { tabReset?.classList.add('is-active');  if (panelReset)  panelReset.style.display  = ''; }\n      if (tab === 'signupConfirm') { if (panelSignupConfirm) panelSignupConfirm.style.display = ''; }\n      setMessage('', '');\n    }\n    function showResetStep(step) {\n      // step: 0(확인버튼) | 1(이메일 입력) | 2(새 비밀번호 입력)\n      if (resetStep0) resetStep0.style.display = step === 0 ? '' : 'none';\n      if (resetStep1) resetStep1.style.display = step === 1 ? '' : 'none';\n      if (resetStep2) resetStep2.style.display = step === 2 ? '' : 'none';\n    }\n\n    tabLogin?.addEventListener('click',  () => showTab('login'));\n    tabSignup?.addEventListener('click', () => showTab('signup'));\n    tabReset?.addEventListener('click',  () => { showTab('reset'); showResetStep(1); });\n\n    if (isRecoveryPending) {\n      // 새 방식 — 아직 토큰을 소비하지 않은 상태. 확인 버튼을 눌러야 다음 단계로 진행.\n      showTab('reset');\n      showResetStep(0);\n    } else if (isSignupPending) {\n      // 가입 인증 링크 — 재설정과 동일하게 버튼을 눌러야만 토큰을 소비한다.\n      showTab('signupConfirm');\n    } else if (isRecovery) {\n      // (해시는 함수 맨 위에서 이미 읽어둔 hashParams/isRecovery를 그대로 사용)\n      // 예전 방식 호환 — supabase.js에서 detectSessionInUrl: false로 꺼놨기 때문에,\n      // 여기서 URL 해시의 access_token/refresh_token을 직접 읽어 세션을 수동으로\n      // 세팅해줘야 updateUser()가 동작한다.\n      showTab('reset');\n      showResetStep(2);\n\n      const access_token  = hashParams.get('access_token');\n      const refresh_token = hashParams.get('refresh_token');\n      if (access_token && refresh_token) {\n        const { error: sessErr } = await supabaseClient.auth.setSession({ access_token, refresh_token });\n        if (sessErr) setMessage('재설정 링크가 만료됐거나 유효하지 않습니다. 다시 요청해 주세요.', 'error');\n      } else {\n        setMessage('재설정 링크가 올바르지 않습니다. 다시 요청해 주세요.', 'error');\n      }\n    } else if (linkError) {\n      // 링크가 만료됐거나(otp_expired) 이미 사용된 경우 — 재설정 요청 화면(1단계)을 보여주고\n      // 왜 실패했는지 명확히 안내한다.\n      showTab('reset');\n      showResetStep(1);\n      const errCode = hashParams.get('error_code') || '';\n      const msg = errCode === 'otp_expired'\n        ? '재설정 링크가 만료됐거나 이미 사용됐습니다. 다시 요청해 주세요.'\n        : '재설정 링크가 유효하지 않습니다. 다시 요청해 주세요.';\n      setMessage(msg, 'error');\n      history.replaceState(null, '', location.pathname); // 에러 해시 제거\n    } else {\n      showTab('login');\n    }\n\n    // ?token_hash 방식의 확인 버튼 — 사용자가 명시적으로 눌러야만 토큰을 소비한다.\n    document.getElementById('resetConfirmLinkBtn')?.addEventListener('click', async function() {\n      this.disabled = true;\n      setMessage('', '');\n      const { error: verifyErr } = await supabaseClient.auth.verifyOtp({\n        token_hash: recoveryTokenHash,\n        type: 'recovery',\n      });\n      if (verifyErr) {\n        setMessage('재설정 링크가 만료됐거나 이미 사용됐습니다. 다시 요청해 주세요.', 'error');\n        showResetStep(1);\n        history.replaceState(null, '', location.pathname); // 쿼리 파라미터 제거\n        this.disabled = false;\n        return;\n      }\n      history.replaceState(null, '', location.pathname); // 쿼리 파라미터 제거\n      showResetStep(2);\n    });\n\n    // ?token_hash&type=signup 방식의 가입 인증 확인 버튼\n    document.getElementById('signupConfirmLinkBtn')?.addEventListener('click', async function() {\n      this.disabled = true;\n      setMessage('', '');\n      const { error: verifyErr } = await supabaseClient.auth.verifyOtp({\n        token_hash: signupTokenHash,\n        type: 'signup',\n      });\n      history.replaceState(null, '', location.pathname); // 쿼리 파라미터 제거\n      if (verifyErr) {\n        showTab('login');\n        setMessage('인증 링크가 만료됐거나 이미 사용됐습니다. 가입을 다시 시도하거나 관리자에게 문의해 주세요.', 'error');\n        return;\n      }\n      // 인증 직후 자동 로그인 세션이 생기므로, 승인 전 상태이므로 바로 로그아웃시킨다.\n      await clearSession();\n      showTab('login');\n      setMessage('✅ 이메일 인증이 완료됐습니다. 관리자 승인 후 로그인하실 수 있습니다.', 'success');\n    });\n\n    /* ── 비밀번호 재설정 ── */\n    document.getElementById('resetSendBtn')?.addEventListener('click', async function() {\n      const email = document.getElementById('resetEmail')?.value?.trim();\n      if (!email) return setMessage('이메일을 입력해 주세요.', 'error');\n      const originalText = this.textContent;\n      this.disabled = true;\n      this.textContent = '발송 중...';\n      setMessage('', '');\n      const redirectTo = location.origin + location.pathname;\n      const { data, error } = await supabaseClient.functions.invoke('send-recovery-email', {\n        body: { email, redirectTo },\n      });\n      this.disabled = false;\n      this.textContent = originalText;\n      if (error || !data?.success) return setMessage('발송 실패: ' + (error?.message || '알 수 없는 오류'), 'error');\n      setMessage('해당 이메일 계정이 존재하면 재설정 링크가 발송됩니다. 메일함을 확인해 주세요.', 'success');\n    });\n\n    document.getElementById('resetConfirmBtn')?.addEventListener('click', async function() {\n      const pw  = document.getElementById('newPassword')?.value?.trim();\n      const pw2 = document.getElementById('newPassword2')?.value?.trim();\n      if (!pw || pw.length < 6) return setMessage('비밀번호를 6자 이상 입력해 주세요.', 'error');\n      if (pw !== pw2) return setMessage('비밀번호가 일치하지 않습니다.', 'error');\n      this.disabled = true;\n      const { error } = await supabaseClient.auth.updateUser({ password: pw });\n      this.disabled = false;\n      if (error) return setMessage('변경 실패: ' + error.message, 'error');\n      setMessage('비밀번호가 변경됐습니다. 로그인해 주세요.', 'success');\n      setTimeout(() => { showTab('login'); history.replaceState(null, '', location.pathname); }, 2000);\n    });\n\n    /* ── 로그인 ── */\n    const loginBtn      = document.getElementById('loginBtn');\n    const emailInput    = document.getElementById('userEmail');\n    const passwordInput = document.getElementById('userPassword');\n\n    async function doLogin() {\n      const email    = emailInput?.value?.trim();\n      const password = passwordInput?.value?.trim();\n      if (!email)    return setMessage('이메일을 입력해 주세요.', 'error');\n      if (!password) return setMessage('비밀번호를 입력해 주세요.', 'error');\n\n      loginBtn.disabled = true;\n      setMessage('', '');\n      if (typeof showGlobalLoading === 'function') showGlobalLoading('로그인 중...');\n\n      const { error } = await supabaseClient.auth.signInWithPassword({ email, password });\n      if (error) {\n        if (typeof hideGlobalLoading === 'function') hideGlobalLoading();\n        setMessage('이메일 또는 비밀번호가 올바르지 않습니다.', 'error');\n        loginBtn.disabled = false;\n        return;\n      }\n\n      // 승인 여부 확인\n      const user = await getSession();\n      if (!user || user.active !== 'Y') {\n        await clearSession();\n        if (typeof hideGlobalLoading === 'function') hideGlobalLoading();\n        setMessage('계정 승인 대기 중입니다. 관리자 승인 후 로그인할 수 있습니다.', 'warn');\n        loginBtn.disabled = false;\n        return;\n      }\n\n      // 로그인 로그\n      // [수정] 예전엔 await 없이 쏘고 바로 아래에서 location.replace()로 페이지를\n      // 이동시켰다 — systemLog() 내부는 auth.getUser() → user_profiles 조회 →\n      // system_logs insert까지 네트워크 왕복이 3번 필요한데, 그 전에 페이지가\n      // 이동(=unload)되면서 요청이 중간에 취소돼 로그가 거의 항상 유실되고 있었다.\n      // 에러가 아니라 \"취소\"라 콘솔에 아무것도 안 남아서 원인 파악이 어려웠다.\n      // 로그인 흐름이 살짝(수백ms) 느려지더라도 반드시 완료된 뒤에 이동해야 한다.\n      if (typeof systemLog === 'function') {\n        try { await systemLog('LOGIN', (user.user_name || user.email) + ' 로그인'); } catch (e) {}\n      }\n\n      // 유휴시간 활동 기록을 지금 시각으로 새로 남긴다 — clearSession()에서 이미 지우고\n      // 있지만, 혹시 모를 경우(다른 탭에서 로그인 등)에 대비한 이중 안전장치.\n      try { localStorage.setItem('maneasy-last-activity', String(Date.now())); } catch(e) {}\n\n      location.replace(getAppUrl());\n    }\n    loginBtn?.addEventListener('click', doLogin);\n    passwordInput?.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });\n\n    /* ── 회원가입 ── */\n    const signupBtn       = document.getElementById('signupBtn');\n    const signupEmail     = document.getElementById('signupEmail');\n    const signupPassword  = document.getElementById('signupPassword');\n    const signupPassword2 = document.getElementById('signupPassword2');\n    const signupName      = document.getElementById('signupName');\n\n    async function doSignup() {\n      const email  = signupEmail?.value?.trim();\n      const pw1    = signupPassword?.value?.trim();\n      const pw2    = signupPassword2?.value?.trim();\n      const name   = signupName?.value?.trim();\n\n      if (!name)          return setMessage('이름을 입력해 주세요.', 'error');\n      if (!email)         return setMessage('이메일을 입력해 주세요.', 'error');\n      if (!pw1)           return setMessage('비밀번호를 입력해 주세요.', 'error');\n      if (pw1.length < 6) return setMessage('비밀번호는 6자 이상이어야 합니다.', 'error');\n      if (pw1 !== pw2)    return setMessage('비밀번호가 일치하지 않습니다.', 'error');\n\n      signupBtn.disabled = true;\n      setMessage('', '');\n      if (typeof showGlobalLoading === 'function') showGlobalLoading('가입 처리 중...');\n\n      // [수정 2026-08] 이메일 인증 절차 자체를 없앴다 — 사내 전용 시스템이라 실질적인\n      // 게이트는 이미 \"관리자 승인\"이 하고 있었는데, GAS로 보내는 인증메일이 사내 메일함에서\n      // 계속 스팸 처리되면서 만료된 링크만 남는 문제가 반복됐다. custom-signup 엣지함수가\n      // 이제 가입 즉시 이메일을 인증완료 상태로 만들고, 인증 링크는 아예 발급/발송하지 않는다.\n      const { data, error } = await supabaseClient.functions.invoke('custom-signup', {\n        body: { email, password: pw1, user_name: name },\n      });\n\n      if (error || !data?.success) {\n        if (typeof hideGlobalLoading === 'function') hideGlobalLoading();\n        setMessage((data && data.error) || error?.message || '회원가입에 실패했습니다.', 'error');\n        signupBtn.disabled = false;\n        return;\n      }\n\n      if (typeof hideGlobalLoading === 'function') hideGlobalLoading();\n      setMessage('✅ 가입 신청이 접수됐습니다. 관리자 승인이 끝나면 로그인하실 수 있어요.', 'success');\n      signupBtn.disabled = false;\n      showTab('login');\n    }\n\n    signupBtn?.addEventListener('click', doSignup);\n    signupPassword2?.addEventListener('keydown', e => { if (e.key === 'Enter') doSignup(); });\n\n    /* ── 캐시 초기화 ── */\n    document.getElementById('clearCacheBtn')?.addEventListener('click', () => {\n      localStorage.clear();\n      sessionStorage.clear();\n      location.reload();\n    });\n  }\n\n  /* ── 로그아웃 ─────────────────────────────────── */\n\n  async function logout() {\n    await clearSession();\n    setTimeout(function() {\n      location.replace(getLoginUrl() + '?logout=1');\n    }, 150);\n  }\n\n  return { getSession, clearSession, requireAuth, requireAdmin, initLoginPage, logout, isMobileDevice, isNarrowScreen, getLoginUrl, getAppUrl };\n})();\n\n/* ── 유휴시간(idle) 자동 로그아웃 ─────────────────────────────\n * 셸(app.html)과 iframe 콘텐츠 페이지가 이 스크립트를 모두 각자 로드하므로(별개의 document라\n * JS 변수를 직접 공유할 수 없음), \"마지막 활동 시각\"을 localStorage에 저장해 공유한다\n * (sessionStorage/localStorage 둘 다 같은 탭 안의 셸+iframe 사이에서는 그대로 공유되므로,\n *  storageKey 'maneasy-auth'가 sessionStorage로 공유되는 것과 같은 원리다).\n * 활동 감지 자체는 모든 프레임(셸 + 현재 열려있는 iframe 콘텐츠 페이지)에서 각자 하지만,\n * 경고 모달 표시와 실제 로그아웃 판단은 최상위 프레임(window.self === window.top, 즉 셸이거나\n * 콘텐츠 페이지를 iframe 없이 단독으로 열었을 때)에서만 한다 — 안 그러면 셸과 iframe이 각자\n * 모달을 띄우거나 로그아웃을 중복 호출하게 된다.\n * 로그인 페이지(index.html, #loginBtn 존재)에서는 세션이 없으므로 아예 동작시키지 않는다.\n */\n(function () {\n  if (document.getElementById('loginBtn')) return; // 로그인 페이지는 제외\n\n  var IDLE_TIMEOUT_MS   = 60 * 60 * 1000; // 1시간 — 이 시점에 실제 로그아웃\n  var WARNING_BEFORE_MS = 60 * 1000;      // 로그아웃 1분 전부터 경고 모달 표시\n  var CHECK_INTERVAL_MS = 1000;           // 1초마다 체크 (경고 모달 카운트다운용)\n  var ACTIVITY_KEY = 'maneasy-last-activity';\n\n  function markActivity() {\n    try { localStorage.setItem(ACTIVITY_KEY, String(Date.now())); } catch (e) {}\n  }\n\n  function getLastActivity() {\n    var v = null;\n    try { v = localStorage.getItem(ACTIVITY_KEY); } catch (e) {}\n    return v ? Number(v) : Date.now();\n  }\n\n  function hasSession() {\n    try { return !!sessionStorage.getItem('maneasy-auth'); } catch (e) { return false; }\n  }\n\n  // 페이지를 새로 열었을 때(브라우저를 며칠 만에 다시 켰을 때 등) markActivity()를 곧바로\n  // 호출해버리면, 실제로 얼마나 오래 자리를 비웠는지와 무관하게 유휴 타이머가 그 순간\n  // \"0초\"로 리셋돼 버린다 — 그래서 브라우저를 껐다 하루 뒤에 열어도 세션이 살아있는 것처럼\n  // 보이는 문제가 있었다. 활동 기록을 새로 쓰기 \"전에\", 이전 기록 기준으로 이미 유휴시간\n  // 초과 상태였는지부터 판단해야 한다.\n  var wasAlreadyIdleTooLong = hasSession() && (Date.now() - getLastActivity()) >= IDLE_TIMEOUT_MS;\n\n  markActivity(); // 페이지 진입 자체도 활동으로 간주 (위 판단 이후에 기록 갱신)\n\n  ['mousedown', 'mousemove', 'keydown', 'scroll', 'touchstart', 'click'].forEach(function (evt) {\n    window.addEventListener(evt, markActivity, { passive: true });\n  });\n\n  if (window.self !== window.top) return; // 경고 모달/로그아웃 판단은 최상위 프레임에서만\n\n  if (wasAlreadyIdleTooLong) {\n    if (window.auth && typeof window.auth.logout === 'function') { window.auth.logout(); return; }\n  }\n\n  /* ── 경고 모달 ── */\n  var modalEl = null;\n\n  function buildModal() {\n    var overlay = document.createElement('div');\n    overlay.id = 'idleWarningOverlay';\n    overlay.style.cssText =\n      'position:fixed;inset:0;z-index:999999;background:rgba(11,22,48,0.45);' +\n      'display:flex;align-items:center;justify-content:center;';\n\n    var box = document.createElement('div');\n    box.style.cssText =\n      'background:#fff;border-radius:14px;box-shadow:0 20px 48px rgba(0,0,0,0.25);' +\n      'padding:28px 32px;min-width:320px;max-width:360px;text-align:center;' +\n      'font-family:inherit;';\n\n    box.innerHTML =\n      '<div style=\"font-size:32px;line-height:1;margin-bottom:12px;\">\\u23F0</div>' +\n      '<div style=\"font-size:15px;font-weight:700;color:#111827;margin-bottom:8px;\">장시간 활동이 없습니다</div>' +\n      '<div style=\"font-size:13px;color:#6b7280;line-height:1.5;margin-bottom:4px;\">' +\n        '<span id=\"idleWarningCountdown\">60</span>초 후 자동으로 로그아웃됩니다.' +\n      '</div>' +\n      '<div style=\"font-size:12px;color:#9ca3af;margin-bottom:18px;\">계속 사용하시려면 아래 버튼을 눌러주세요.</div>' +\n      '<button id=\"idleWarningContinueBtn\" type=\"button\" style=\"' +\n        'background:#2563eb;color:#fff;border:none;border-radius:8px;' +\n        'padding:9px 24px;font-size:13px;font-weight:700;cursor:pointer;\">계속 사용하기</button>';\n\n    overlay.appendChild(box);\n    document.body.appendChild(overlay);\n\n    document.getElementById('idleWarningContinueBtn').addEventListener('click', function () {\n      markActivity();\n      hideModal();\n    });\n\n    return overlay;\n  }\n\n  function showModal(secondsLeft) {\n    if (!modalEl) modalEl = buildModal();\n    var countdownEl = document.getElementById('idleWarningCountdown');\n    if (countdownEl) countdownEl.textContent = String(secondsLeft);\n  }\n\n  function hideModal() {\n    if (modalEl && modalEl.parentNode) modalEl.parentNode.removeChild(modalEl);\n    modalEl = null;\n  }\n\n  setInterval(function () {\n    if (!hasSession()) { hideModal(); return; }\n\n    var idleFor = Date.now() - getLastActivity();\n    var remaining = IDLE_TIMEOUT_MS - idleFor;\n\n    if (remaining <= 0) {\n      hideModal();\n      if (window.auth && typeof window.auth.logout === 'function') window.auth.logout();\n    } else if (remaining <= WARNING_BEFORE_MS) {\n      showModal(Math.ceil(remaining / 1000));\n    } else {\n      hideModal(); // 경고가 떠 있던 중 다른 탭/프레임에서의 활동 등으로 여유가 다시 생긴 경우\n    }\n  }, CHECK_INTERVAL_MS);\n})();"
          },
