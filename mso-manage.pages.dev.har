          "content": {
            "size": 9911,
            "mimeType": "application/javascript",
            "text": "/**\n * assets/js/core/permissions.js\n * 앱/페이지 단위 권한 판단 공용 모듈.\n *\n * 업무일지(task/task-manager)를 제외한 모든 페이지는 아래 5단계로 통일한다.\n *   접근불가 : 접근 자체 불가\n *   user     : 조회만 (조회 성격 페이지는 이 이상도 조회만) / 신청·요청 성격 페이지는\n *              \"본인 것\" 작성·취소까지 포함\n *   edit     : 조회 + 수정(등록/수정/처리) — 화면엔 \"editor\"로 표기하되 코드/DB 값은\n *              기존 관례대로 'edit' 그대로 사용한다\n *   manager  : edit과 동일 + \"이력관리성격\" 페이지(사인물·프로그램 신청내역)에서는\n *              본인 것뿐 아니라 전체 조회·처리 가능 / \"마스터 성격\" 페이지(의원·부서·\n *              사용자, 자재·거래처)는 manager부터 등록·수정 가능(그 밑은 접근불가)\n *   admin    : manager와 동일 + 실제로 \"삭제\" 개념이 있는 곳(장비 폐기, 마스터 데이터\n *              삭제, 공지사항 삭제)에서 삭제까지 가능\n *\n * 공지사항(master/notice)·시스템로그(master/syslog)·AI 기능요청(master/ai-requests)은\n * \"admin 전용\" 성격이지만, page_perms로 개별 계정에 명시적으로 권한을 부여해야만\n * 접근 가능하다(기본값은 전원 접근불가).\n *\n * [★2026-07 정리] 예전엔 user_profiles.role(당시 값 'admin'/'user', 현재는 'all_clinic'/\n * 'own_clinic')이 두 가지 역할을 겸했다:\n *   1) \"전체 의원 조회 scope\" 판단\n *   2) 페이지 권한 기본 템플릿(구 ROLE_DEFAULT_PAGES) 선택\n * role='all_clinic'이 \"시스템 관리자\"를 뜻하는 게 아닌데도 권한까지 같이 딸려오는 구조라 혼란이\n * 있었다. 이제 role은 (1)번 scope 판단에만 쓰고, 페이지 권한은 아래 DEFAULT_PAGES 단일\n * 기본값 + 사용자별 page_perms로만 결정한다 — role은 이 파일에서 전혀 참조하지 않는다.\n * 시스템 관리자/사인물 담당자 여부는 user_profiles.is_admin / is_signage_manager로 별도 관리.\n *\n * 판단 순서:\n *   1) user.page_perms에 해당 pageKey가 있으면 그 값을 그대로 쓴다.\n *   2) 없으면 DEFAULT_PAGES(전원 공통 최저 기본값)를 대신 쓴다.\n * 모든 사용자는 가입 시 DEFAULT_PAGES가 page_perms에 명시적으로 저장되므로(2)는\n * 사실상 안전망이다 — master/org.js 사용자 수정 화면에서 페이지별로 올려서 관리한다.\n */\nwindow.PagePerms = (function () {\n  var LEVELS = ['접근불가', 'user', 'edit', 'manager', 'admin'];\n\n  // 페이지별로 \"각 레벨이 실제로 무엇을 할 수 있는지\" 설명 — 사용자 수정 화면에 노출된다.\n  var LEVEL_DESCRIPTIONS = {\n    'equipment/dashboard':        { user: '조회', edit: '조회', manager: '조회', admin: '조회' },\n    'equipment/list':             { user: '조회', edit: '조회', manager: '조회', admin: '조회' },\n    'equipment/detail':           { user: '조회', edit: '조회', manager: '조회', admin: '조회' },\n    'equipment/form':             { user: '접근불가', edit: '등록·수정', manager: '등록·수정', admin: '등록·수정 + 폐기' },\n    'materials/purchase-request': { user: '요청 작성·취소(본인)', edit: '요청 작성·취소(본인)', manager: '요청 작성·취소(본인)', admin: '요청 작성·취소(본인)' },\n    'materials/use-stock':        { user: '사용처리 입력', edit: '사용처리 입력', manager: '사용처리 입력', admin: '사용처리 입력' },\n    'materials/procurement':      { user: '발주 취소만 가능', edit: '확인·발주서 작성·취소', manager: '확인·발주서 작성·취소', admin: '확인·발주서 작성·취소' },\n    'materials/stock':            { user: '조회만 가능', edit: '입고·불출 처리', manager: '입고·불출 처리', admin: '입고·불출 처리' },\n    'materials/material-stats':   { user: '조회', edit: '조회', manager: '조회', admin: '조회' },\n    'signage/apply':              { user: '신청 작성', edit: '신청 작성', manager: '신청 작성', admin: '신청 작성' },\n    'signage/history':            { user: '본인 신청만 조회·취소', edit: '본인 신청만 조회·취소', manager: '전체 조회 + 상태처리', admin: '전체 조회 + 상태처리 + 완료 상태 되돌리기' },\n    'program-request/apply':      { user: '신청 작성', edit: '신청 작성', manager: '신청 작성', admin: '신청 작성' },\n    'program-request/history':    { user: '본인 신청만 조회·취소', edit: '본인 신청만 조회·취소', manager: '전체 조회 + 상태처리', admin: '전체 조회 + 상태처리 + 완료 상태 되돌리기' },\n    'master/org':                 { user: '접근불가', edit: '접근불가', manager: '조회 + 등록·수정', admin: '동일 + 삭제' },\n    'master/supply':              { user: '접근불가', edit: '접근불가', manager: '조회 + 등록·수정', admin: '동일 + 삭제' },\n    'committee/list':             { user: '조회', edit: '조회', manager: '조회 + 등록·수정', admin: '동일 + 삭제' },\n    'regulation/list':            { user: '조회', edit: '조회', manager: '조회 + 등록·수정', admin: '동일 + 삭제' },\n    'master/notice':              { user: '접근불가', edit: '접근불가', manager: '접근불가', admin: '조회·작성·수정·삭제 (개별 권한 부여된 계정만)' },\n    'master/syslog':              { user: '접근불가', edit: '접근불가', manager: '접근불가', admin: '조회 (개별 권한 부여된 계정만)' },\n    'master/ai-requests':          { user: '접근불가', edit: '접근불가', manager: '접근불가', admin: '조회·상태변경 (개별 권한 부여된 계정만)' },\n    'management/closing':         { user: '접근불가', edit: '마감 입력·처리', manager: '마감 입력·처리', admin: '마감 입력·처리 + 삭제' },\n    'management/sole-source':     { user: '사유서 작성, 전체 조회', edit: '사유서 작성, 전체 조회(+본인만 토글 가능)', manager: '동일', admin: '동일 + 제출완료된 건도 내용 수정(상태·작성자 유지)' },\n    'management/statistics':      { user: '조회', edit: '조회', manager: '조회', admin: '조회' },\n    'contracts/list':              { user: '조회', edit: '조회', manager: '조회(내 담당만 토글 노출)', admin: '조회' },\n    'contracts/detail':            { user: '조회', edit: '조회', manager: '조회', admin: '조회' },\n    'contracts/form':              { user: '등록 가능, 본인이 작성했거나 담당자로 지정된 계약만 수정', edit: '등록 + 전체 계약 수정', manager: '등록 + 전체 계약 수정', admin: '등록 + 전체 계약 수정 + 삭제' },\n  };\n\n  // 전원 공통 최저 기본값(구 ROLE_DEFAULT_PAGES.user와 동일) — 신규 가입자 기본값이자,\n  // page_perms에 특정 pageKey가 없을 때 쓰는 안전망. role과는 무관하다.\n  var DEFAULT_PAGES = {\n    'equipment/dashboard':        'user',\n    'equipment/list':             'user',\n    'equipment/detail':           'user',\n    'equipment/form':             '접근불가',\n    'materials/purchase-request': 'user',\n    'materials/use-stock':        'user',\n    'materials/procurement':      '접근불가',\n    'materials/stock':            '접근불가',\n    'materials/material-stats':   'user',\n    'task/task-manager':          'user',\n    'signage/apply':              'user',\n    'signage/history':            'user',\n    'program-request/apply':      'user',\n    'program-request/history':    'user',\n    'master/org':                 '접근불가',\n    'master/supply':              '접근불가',\n    'committee/list':             '접근불가',\n    'regulation/list':            '접근불가',\n    'master/notice':              '접근불가',\n    'master/syslog':              '접근불가',\n    'master/ai-requests':         '접근불가',\n    'management/closing':         '접근불가',\n    'management/sole-source':     'user',\n    'management/statistics':      'user',\n    'contracts/list':              '접근불가',\n    'contracts/detail':            '접근불가',\n    'contracts/form':              '접근불가',\n  };\n\n  /** user: auth.getSession()이 반환하는 프로필 객체(page_perms 포함). pageKey: 'equipment/list' 등. */\n  function getLevel(user, pageKey) {\n    if (!user) return '접근불가';\n    // page_perms에 이 pageKey가 명시적으로 저장돼 있으면 그 값을 그대로 쓰고,\n    // 없으면 DEFAULT_PAGES로 보완한다(신규 페이지 추가 시 기존 사용자가 막히지 않도록).\n    if (user.page_perms && Object.prototype.hasOwnProperty.call(user.page_perms, pageKey)) {\n      return user.page_perms[pageKey] || '접근불가';\n    }\n    return DEFAULT_PAGES[pageKey] || '접근불가';\n  }\n\n  /** 해당 페이지에 대해 minLevel 이상의 권한을 갖고 있는지 */\n  function atLeast(user, pageKey, minLevel) {\n    var level = getLevel(user, pageKey);\n    return LEVELS.indexOf(level) >= LEVELS.indexOf(minLevel);\n  }\n\n  /** 접근 자체가 가능한지 (접근불가만 아니면 true) */\n  function canAccess(user, pageKey) {\n    return getLevel(user, pageKey) !== '접근불가';\n  }\n\n  /** allPageKeys 중 현재 사용자가 접근 가능한 페이지 키만 걸러서 반환 (사이드바 등에서 사용) */\n  function getAllowedPages(user, allPageKeys) {\n    return (allPageKeys || []).filter(function(k) { return canAccess(user, k); });\n  }\n\n  return {\n    LEVELS: LEVELS,\n    LEVEL_DESCRIPTIONS: LEVEL_DESCRIPTIONS,\n    DEFAULT_PAGES: DEFAULT_PAGES,\n    getLevel: getLevel,\n    atLeast: atLeast,\n    canAccess: canAccess,\n    getAllowedPages: getAllowedPages,\n  };\n})();"
          },
