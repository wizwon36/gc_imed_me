          "content": {
            "size": 32950,
            "mimeType": "application/javascript",
            "text": "'use strict';\n\n/* ══════════════════════════════════════════════════════════\n   AI 어시스턴트 (플로팅 위젯) — app.html(셸)에서 initAIAssistant()로 호출됨.\n   - marked.js로 마크다운 렌더링(표/목록/굵게 등), DOMPurify로 살균 후 innerHTML에 삽입.\n   - 서버(ai-assistant Edge Function)가 action:{type:'navigate', page_key}를 내려주면\n     window.shellNavigate(page_key)를 호출해 실제 페이지 이동까지 수행한다.\n   - [추가] FAB 버튼을 자유롭게 드래그해 위치 이동 가능(위치는 localStorage에 저장되어 유지됨).\n   - [추가] 대화창을 처음 열었을 때(또는 \"새 대화\" 시작 시) 사용 가능한 기능을 안내하는\n     온보딩 메시지 + 바로 눌러볼 수 있는 추천 버튼을 보여준다.\n═══════════════════════════════════════════════════════════ */\n\nvar AI_FAB_POS_KEY = 'ai_fab_position_v1';\n// [추가] 새로고침해도 대화가 끊기지 않도록 세션 단위(탭 닫으면 사라짐)로 대화 상태를 저장.\nvar AI_CHAT_STATE_KEY = 'ai_chat_state_v1';\n\n// ── 장비 유지보수 만료 임박 알림 (인앱 뱃지) ──\n// GAS(sendMaintenanceAlert)의 scope 판정 로직과 동일하게 유지할 것.\nvar MAINT_ALERT_DAYS = 60; // [수정] 계약 만료 알림(D-60)과 기준을 맞춰서 30일 → 60일로 통일\n\n// [추가] 계약 만료 임박 알림 — 계약 담당자(owner_id)에게 D-60 기준으로 알려준다.\n// 메일로 보내면 스팸으로 걸러지는 문제가 있어(요청 배경), 장비 알림과 동일하게 인앱 FAB\n// 뱃지/배너로 대체한다. 다만 이 뱃지는 실제 ai-assistant 서버(Edge Function, 이 저장소 밖에 있음)의\n// LLM 답변이 아니라, 클라이언트에서 get_contract_expiry_alert_candidates RPC 결과를 그대로\n// 마크다운으로 렌더링해서 보여준다 — 서버 쪽 도구 목록에 계약 조회가 없어도 항상 정확하게 동작한다.\nvar CONTRACT_ALERT_DAYS = 60;\n\nvar AI_SUGGESTIONS = [\n  { label: '이번 주 일정', prompt: '이번 주 내 업무일정 보여줘' },\n  { label: '장비 조회', prompt: '유효기간 60일 이내로 남은 장비 알려줘' },\n  { label: '공지사항', prompt: '최근 공지사항 보여줘' },\n  { label: '내 신청내역', prompt: '내가 신청한 사인물/프로그램 요청 처리 상태 알려줘' },\n];\n\n// [추가] 모바일 셸에서는 프로그램(오류수정·신규기능) 신청 탭 자체가 없으므로(데스크톱 전용\n// 기능으로 정리됨), 추천 버튼 문구에서도 프로그램 신청 언급은 빼고 사인물만 남긴다 —\n// 버튼을 눌렀을 때 안내받는 내용과 실제 모바일에서 확인 가능한 화면이 어긋나지 않게 하기 위함.\nvar AI_SUGGESTIONS_MOBILE = [\n  { label: '이번 주 일정', prompt: '이번 주 내 업무일정 보여줘' },\n  { label: '장비 조회', prompt: '유효기간 60일 이내로 남은 장비 알려줘' },\n  { label: '공지사항', prompt: '최근 공지사항 보여줘' },\n  { label: '내 신청내역', prompt: '내가 신청한 사인물 요청 처리 상태 알려줘' },\n];\n\n// [추가] 장비 담당자에게만 노출되는 추천 질문 — 일반 사용자에게는 굳이 보여줄 필요 없는 항목.\nvar AI_SUGGESTIONS_EQUIPMENT_MANAGER = [\n  { label: '심평원 미등록 장비', prompt: '심평원 미등록 장비 알려줘' },\n  { label: '점검 예정 장비', prompt: '점검 예정일이 지났거나 임박한 장비 알려줘' },\n];\n\n// [추가] 계약관리 접근 권한이 있는 사용자에게 노출되는 추천 버튼 — 계약 조회는 서버(LLM) 도구가\n// 없으므로 prompt 대신 localAction으로 표시해서, 클릭 시 서버로 보내지 않고 클라이언트에서\n// 직접 조회해 마크다운으로 바로 그려준다(아래 handleSuggestionClick 참고).\nvar AI_SUGGESTIONS_CONTRACT_OWNER = [\n  { label: '내 담당 계약 현황', localAction: 'contractSummary' },\n  { label: '자동연장 계약 목록', localAction: 'contractAutoRenewList' },\n];\n\nvar AI_ONBOARDING_TEXT =\n  '안녕하세요! 저는 업무지원 AI 어시스턴트예요. 이런 걸 도와드릴 수 있어요.\\n\\n' +\n  '- **자재 가격 검색**: 자재/소모품 이름으로 가격·품목코드 조회\\n' +\n  '- **업무일정 관리**: 일정 등록, 조회, 완료/진행중 상태 변경\\n' +\n  '- **장비 조회**: 부서·팀별 장비 목록, 유효기간 임박 장비, 장비 상세정보\\n' +\n  '- **공지사항 조회**: 최근 공지사항 확인\\n' +\n  '- **신청 접수/조회**: 사인물(일반)·프로그램(오류수정·신규기능) 신청 접수 및 처리 상태 확인\\n' +\n  '- **페이지 이동**: \"~페이지로 가고 싶어\" 같은 요청으로 바로 이동\\n\\n' +\n  '자재명이나 장비명은 띄어쓰기·어순이 달라도 괜찮아요. 아래 버튼을 눌러보거나 편하게 물어보세요!';\n\n// [추가] 모바일 셸 전용 온보딩 문구 — 모바일에는 프로그램 신청 탭이 없고(데스크톱 전용으로 정리됨),\n// 페이지 이동도 하단 5탭(장비/계약/업무일정/사인물/AI) 범위 안에서만 가능하다. 데스크톱과 동일한\n// 문구를 그대로 보여주면 \"여기서도 프로그램 신청을 처리할 수 있나?\" 같은 혼동을 주므로 모바일에서\n// 실제로 확인 가능한 항목만 안내한다.\nvar AI_ONBOARDING_TEXT_MOBILE =\n  '안녕하세요! 저는 업무지원 AI 어시스턴트예요. 이런 걸 도와드릴 수 있어요.\\n\\n' +\n  '- **자재 가격 검색**: 자재/소모품 이름으로 가격·품목코드 조회\\n' +\n  '- **업무일정 관리**: 일정 등록, 조회, 완료/진행중 상태 변경\\n' +\n  '- **장비 조회**: 부서·팀별 장비 목록, 유효기간 임박 장비, 장비 상세정보\\n' +\n  '- **계약 조회**: 내 담당 계약 현황, 자동연장 계약 목록 확인\\n' +\n  '- **공지사항 조회**: 최근 공지사항 확인\\n' +\n  '- **신청 접수/조회**: 사인물 신청 접수 및 처리 상태 확인\\n' +\n  '- **화면 이동**: \"~보여줘\" 같은 요청으로 하단 탭 화면으로 바로 이동(장비·계약·업무일정·사인물)\\n\\n' +\n  '자재명이나 장비명은 띄어쓰기·어순이 달라도 괜찮아요. 아래 버튼을 눌러보거나 편하게 물어보세요!';\n\nfunction initAIAssistant(user) {\n  var fab = document.getElementById('aiFab');\n  var fabBadge = document.getElementById('aiFabBadge');\n  var panel = document.getElementById('aiPanel');\n  var panelHeader = document.getElementById('aiPanelHeader');\n  var closeBtn = document.getElementById('aiCloseBtn');\n  var newChatBtn = document.getElementById('aiNewChatBtn');\n  var messagesEl = document.getElementById('aiMessages');\n  var input = document.getElementById('aiInput');\n  var sendBtn = document.getElementById('aiSendBtn');\n  if (!fab || !panel) return;\n\n  var interactionId = null;\n  var sending = false;\n  var maintAlertCount = 0;\n  var contractAlertCount = 0;\n  var contractAlertItems = [];\n  var missingSsjCount = 0;\n  var missingSsjItems = [];\n  // [추가] 심평원 미등록 장비 알림 — 장비 담당자에게만 노출(기존 유지보수 알림과 동일한 대상/범위 기준).\n  var hiraUnregCount = 0;\n  var canAccessContracts = !!(window.PagePerms && window.PagePerms.canAccess(user, 'contracts/list'));\n\n  // [추가] 장비 알림 + 계약 만료 알림 + 수의계약 사유서 미작성 알림 + 심평원 미등록 알림 숫자를 합쳐서 FAB에 하나로 표시한다.\n  function updateFabBadge() {\n    if (!fabBadge) return;\n    var total = maintAlertCount + contractAlertCount + missingSsjCount + hiraUnregCount;\n    if (total > 0) {\n      fabBadge.textContent = total > 9 ? '9+' : String(total);\n      fabBadge.style.display = '';\n    } else {\n      fabBadge.style.display = 'none';\n    }\n  }\n\n  /* ── 장비 유지보수 만료 임박 알림 (GAS sendMaintenanceAlert와 동일한 판정) ── */\n  // [수정] page_perms(admin/manager 레벨) 조합 대신 is_equipment_manager 플래그로 대상을,\n  // role(all_clinic/own_clinic)로 범위(scope)만 판단 — GAS와 동일하게 2026-07 정리.\n  async function checkMaintenanceAlerts() {\n    if (!user) return;\n    try {\n      if (!user.is_equipment_manager) return; // 장비 담당자가 아니면 뱃지 자체를 노출하지 않음\n      var scope = user.role === 'all_clinic' ? 'all' : 'clinic';\n\n      var { data, error } = await supabaseClient.rpc('get_maintenance_alert_candidates', { p_alert_days: MAINT_ALERT_DAYS });\n      if (error) throw error;\n\n      var targets = data || [];\n      if (scope === 'clinic') targets = targets.filter(function(e) { return e.clinic_code === user.clinic_code; });\n\n      maintAlertCount = targets.length;\n      updateFabBadge();\n    } catch (e) {\n      // 뱃지 조회 실패는 조용히 무시 — 메인 AI 대화 기능에는 영향 없어야 함\n    }\n  }\n\n  /* ── 심평원 미등록 장비 알림 (장비 담당자 전용) ──\n     기존 유지보수 만료 알림(checkMaintenanceAlerts)과 동일하게 is_equipment_manager로 대상을,\n     role(all_clinic/own_clinic)로 범위를 판단한다. 별도 RPC 없이 equipments 테이블을 직접 조회. */\n  async function checkHiraUnregisteredAlerts() {\n    if (!user) return;\n    try {\n      if (!user.is_equipment_manager) return;\n      var scope = user.role === 'all_clinic' ? 'all' : 'clinic';\n      var q = supabaseClient.from('equipments').select('id', { count: 'exact', head: true })\n        .eq('deleted_yn', 'N').is('hira_registered', false);\n      if (scope === 'clinic' && user.clinic_code) q = q.eq('clinic_code', user.clinic_code);\n      var { count, error } = await q;\n      if (error) throw error;\n      hiraUnregCount = count || 0;\n      updateFabBadge();\n    } catch (e) {\n      // 뱃지 조회 실패는 조용히 무시 — 메인 AI 대화 기능에는 영향 없어야 함\n    }\n  }\n\n  /* ── 계약 만료 임박 알림 (D-60, 담당자owner_id 기준) ──\n     메일 발송은 스팸으로 걸러지는 문제가 있어(요청 배경) 장비 알림과 동일하게 인앱으로 대체.\n     계약 조회는 ai-assistant 서버(Edge Function)의 도구 목록에 없으므로, LLM에 물어보는 대신\n     get_contract_expiry_alert_candidates RPC 결과를 클라이언트에서 직접 마크다운으로 그려서 보여준다. */\n  async function checkContractExpiryAlerts() {\n    if (!user) return;\n    try {\n      var { data, error } = await supabaseClient.rpc('get_contract_expiry_alert_candidates', { p_alert_days: CONTRACT_ALERT_DAYS });\n      if (error) throw error;\n      contractAlertItems = (data || []).filter(function(c) { return c.owner_id === user.id; })\n        .sort(function(a, b) { return (a.effective_end_date || '').localeCompare(b.effective_end_date || ''); });\n      contractAlertCount = contractAlertItems.length;\n      updateFabBadge();\n    } catch (e) {\n      // 뱃지 조회 실패는 조용히 무시 — 메인 AI 대화 기능에는 영향 없어야 함\n    }\n  }\n\n  // 계약 만료 임박 배너를 눌렀을 때 보여줄 마크다운 목록 — 서버 LLM을 거치지 않고 바로 렌더링.\n  function contractAlertMarkdown() {\n    var lines = ['**담당 계약 중 ' + CONTRACT_ALERT_DAYS + '일 이내 만료 예정인 계약이에요.**', ''];\n    contractAlertItems.forEach(function(c) {\n      var autoTag = c.auto_renew === 'Y' ? ' `자동연장`' : '';\n      var dday = Math.round((new Date(c.effective_end_date + 'T00:00:00') - new Date(new Date().toDateString())) / 86400000);\n      var urgentTag = (!autoTag && dday <= 7) ? ' ⚠️' : '';\n      lines.push('- ' + (c.contract_title || c.doc_no || '') + ' — ' + c.effective_end_date + '까지(D-' + dday + ')' + autoTag + urgentTag);\n    });\n    lines.push('', '계약관리 > 계약목록에서 자세히 확인할 수 있어요.');\n    return lines.join('\\n');\n  }\n\n  /* ── 수의계약 사유서 미작성 알림 (내부거래 + 수의계약, 2026-08-21 이후 등록 건만 대상) ──\n     get_missing_sole_source_justification_candidates RPC 참고 — 기존에 쌓여있던 계약까지\n     한꺼번에 경고하면 알림 피로만 커진다는 요청에 따라, 이 기능이 배포된 시점 이후 새로 등록된\n     계약만 대상으로 한다. */\n  async function checkMissingSsjAlerts() {\n    if (!user) return;\n    try {\n      var { data, error } = await supabaseClient.rpc('get_missing_sole_source_justification_candidates');\n      if (error) throw error;\n      missingSsjItems = (data || []).filter(function(c) { return c.owner_id === user.id; });\n      missingSsjCount = missingSsjItems.length;\n      updateFabBadge();\n    } catch (e) {\n      // 뱃지 조회 실패는 조용히 무시 — 메인 AI 대화 기능에는 영향 없어야 함\n    }\n  }\n\n  function missingSsjMarkdown() {\n    var lines = ['**내부거래 수의계약인데 사유서가 아직 작성되지 않은 계약이 있어요.**', ''];\n    missingSsjItems.forEach(function(c) {\n      lines.push('- ' + (c.contract_title || c.doc_no || '') + (c.counterparty_name ? ' (' + c.counterparty_name + ')' : ''));\n    });\n    lines.push('', '계약 상세화면의 \"수의계약 사유서 연결\"에서 작성할 수 있어요.');\n    return lines.join('\\n');\n  }\n\n  /* ── 내 담당 계약 현황 요약 / 자동연장 계약 목록 ──\n     둘 다 서버 LLM을 거치지 않고, 클라이언트에서 contracts 테이블을 직접 조회해 마크다운으로 그린다. */\n  async function showContractSummary() {\n    var loadingEl = addMessage('조회 중...', 'ai-msg-loading', false, true);\n    try {\n      var { data, error } = await supabaseClient\n        .from('contracts').select('status, auto_renew, has_period')\n        .eq('owner_id', user.id).is('deleted_at', null);\n      loadingEl.remove();\n      if (error) throw error;\n      var rows = data || [];\n      var active = rows.filter(function(r) { return r.status === 'ACTIVE'; });\n      var expired = rows.filter(function(r) { return r.status === 'EXPIRED'; });\n      var terminated = rows.filter(function(r) { return r.status === 'TERMINATED'; });\n      var activeAutoRenew = active.filter(function(r) { return r.auto_renew === 'Y'; });\n      var lines = [\n        '**내 담당 계약 현황 (총 ' + rows.length + '건)**', '',\n        '- 진행중: ' + active.length + '건 (이 중 자동연장 ' + activeAutoRenew.length + '건)',\n        '- 만료: ' + expired.length + '건',\n        '- 해지: ' + terminated.length + '건',\n        '- ' + CONTRACT_ALERT_DAYS + '일 이내 만료 예정: ' + contractAlertCount + '건',\n      ];\n      addMessage(lines.join('\\n'), 'ai-msg-bot', true);\n    } catch (e) {\n      loadingEl.remove();\n      addMessage('조회 중 오류가 발생했어요: ' + (e && e.message ? e.message : String(e)), 'ai-msg-err', false);\n    }\n  }\n\n  async function showAutoRenewContracts() {\n    var loadingEl = addMessage('조회 중...', 'ai-msg-loading', false, true);\n    try {\n      var { data, error } = await supabaseClient\n        .from('contracts')\n        .select('contract_title, doc_no, contract_end, auto_renew_cycle_months')\n        .eq('owner_id', user.id).eq('status', 'ACTIVE').eq('auto_renew', 'Y').is('deleted_at', null)\n        .order('contract_end', { ascending: true });\n      loadingEl.remove();\n      if (error) throw error;\n      var rows = data || [];\n      if (!rows.length) { addMessage('자동연장으로 설정된 담당 계약이 없어요.', 'ai-msg-bot', false); return; }\n      var lines = ['**자동연장 계약 (' + rows.length + '건)**', ''];\n      rows.forEach(function(r) {\n        lines.push('- ' + (r.contract_title || r.doc_no || '') + ' — 다음 연장 시점: ' + (r.contract_end || '-') +\n          (r.auto_renew_cycle_months ? ' (' + r.auto_renew_cycle_months + '개월 주기)' : ''));\n      });\n      addMessage(lines.join('\\n'), 'ai-msg-bot', true);\n    } catch (e) {\n      loadingEl.remove();\n      addMessage('조회 중 오류가 발생했어요: ' + (e && e.message ? e.message : String(e)), 'ai-msg-err', false);\n    }\n  }\n\n  var LOCAL_ACTIONS = {\n    contractSummary: showContractSummary,\n    contractAutoRenewList: showAutoRenewContracts,\n  };\n\n  /* ── 마크다운 렌더링 ── */\n  function renderMarkdown(text) {\n    var raw = String(text == null ? '' : text);\n    try {\n      if (typeof marked !== 'undefined') {\n        var html = marked.parse(raw, { breaks: true });\n        if (typeof DOMPurify !== 'undefined') html = DOMPurify.sanitize(html);\n        // AI가 답변 텍스트 안에 마크다운 링크(예: \"[장비 관리 페이지 바로가기](...)\")를 쓰는\n        // 경우가 있는데, 이 시스템에서 실제 페이지 이동은 반드시 navigate_to_page 도구 호출을\n        // 통해서만 일어나야 한다(권한 검사가 거기서만 됨). 텍스트 속 링크는 목적지가 검증되지\n        // 않은 채로 클릭 가능한 <a>가 되어버리므로, href를 전부 제거해 순수 텍스트로 남긴다.\n        var wrap = document.createElement('div');\n        wrap.innerHTML = html;\n        wrap.querySelectorAll('a').forEach(function(a) {\n          var span = document.createElement('span');\n          span.textContent = a.textContent;\n          a.replaceWith(span);\n        });\n        return wrap.innerHTML;\n      }\n    } catch (e) { /* 마크다운 파싱 실패 시 아래 escape 처리로 폴백 */ }\n    return String(raw).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\n/g, '<br>');\n  }\n\n  function addMessage(text, cls, isMarkdown, skipSave) {\n    var div = document.createElement('div');\n    div.className = 'ai-msg ' + cls;\n    if (isMarkdown) {\n      div.innerHTML = renderMarkdown(text);\n    } else {\n      div.textContent = text;\n    }\n    messagesEl.appendChild(div);\n    messagesEl.scrollTop = messagesEl.scrollHeight;\n    if (!skipSave) {\n      chatHistory.push({ text: text, cls: cls, isMarkdown: !!isMarkdown });\n      saveChatState();\n    }\n    return div;\n  }\n\n  /* ── 대화 상태 저장/복원 (새로고침해도 대화 유지 — 탭을 닫으면 사라짐) ── */\n  var chatHistory = [];\n\n  function saveChatState() {\n    try {\n      sessionStorage.setItem(AI_CHAT_STATE_KEY, JSON.stringify({ interactionId: interactionId, history: chatHistory }));\n    } catch (e) { /* 저장 실패는 무시 — 대화 자체는 계속 동작 */ }\n  }\n\n  function clearChatState() {\n    try { sessionStorage.removeItem(AI_CHAT_STATE_KEY); } catch (e) {}\n  }\n\n  function restoreChatState() {\n    try {\n      var raw = sessionStorage.getItem(AI_CHAT_STATE_KEY);\n      if (!raw) return false;\n      var state = JSON.parse(raw);\n      if (!state || !Array.isArray(state.history) || state.history.length === 0) return false;\n      interactionId = state.interactionId || null;\n      state.history.forEach(function(m) { addMessage(m.text, m.cls, m.isMarkdown, true); });\n      chatHistory = state.history;\n      return true;\n    } catch (e) { return false; }\n  }\n\n  /* ── 알림 배너 렌더링 (장비/계약/사유서) ──\n     [수정] 예전에는 showOnboarding() 안에서만 그려졌는데, showOnboarding()은 대화창을\n     \"처음\" 열 때(messagesEl이 비어있을 때)만 호출된다. sessionStorage에 저장된 이전 대화\n     기록이 있으면(restoreChatState) 다음 접속 때 messagesEl이 이미 채워진 채로 시작되어\n     showOnboarding()이 다시 호출되지 않고, 그 결과 FAB 뱃지는 9+로 계속 뜨는데 정작\n     대화창을 열어보면 인사말만 있고 배너는 하나도 안 보이는 문제가 있었다.\n     이제 배너는 대화 기록 존재 여부와 무관하게, 탭(페이지 로드)당 한 번은 패널을 열 때\n     항상 최신 알림 개수 기준으로 다시 그려서 맨 위에 붙인다(prepend). */\n  var bannersRenderedThisLoad = false;\n  function renderAlertBanners(prepend) {\n    var frag = document.createDocumentFragment();\n    if (maintAlertCount > 0) {\n      var banner = document.createElement('div');\n      banner.className = 'ai-alert-banner';\n      banner.innerHTML = '<i class=\"ti ti-alert-triangle\"></i><span>유지보수 만료 임박 장비 <strong>' + maintAlertCount + '건</strong>이 있어요. 탭해서 확인하기</span>';\n      banner.addEventListener('click', function() {\n        if (sending) return;\n        input.value = '유효기간 60일 이내로 남은 장비 알려줘';\n        sendMessage();\n      });\n      frag.appendChild(banner);\n    }\n    // [추가] 계약 만료 임박 배너 — 장비 배너와 달리 서버 LLM을 거치지 않고, 클릭 시 바로\n    // contractAlertMarkdown()으로 만든 목록을 봇 메시지로 렌더링한다(계약 조회는 서버 도구에 없음).\n    if (contractAlertCount > 0) {\n      var ctBanner = document.createElement('div');\n      ctBanner.className = 'ai-alert-banner';\n      ctBanner.innerHTML = '<i class=\"ti ti-file-alert\"></i><span>만료 임박(D-' + CONTRACT_ALERT_DAYS + ') 담당 계약 <strong>' + contractAlertCount + '건</strong>이 있어요. 탭해서 확인하기</span>';\n      ctBanner.addEventListener('click', function() {\n        addMessage(contractAlertMarkdown(), 'ai-msg-bot', true);\n      });\n      frag.appendChild(ctBanner);\n    }\n    // [추가] 수의계약 사유서 미작성 배너 — 2026-08-21 이후 등록된 내부거래·수의계약 중\n    // 사유서가 하나도 연결되지 않은 건만 대상(기존에 쌓여있던 계약은 제외).\n    if (missingSsjCount > 0) {\n      var ssjBanner = document.createElement('div');\n      ssjBanner.className = 'ai-alert-banner';\n      ssjBanner.innerHTML = '<i class=\"ti ti-file-alert\"></i><span>사유서 미작성 수의계약 <strong>' + missingSsjCount + '건</strong>이 있어요. 탭해서 확인하기</span>';\n      ssjBanner.addEventListener('click', function() {\n        addMessage(missingSsjMarkdown(), 'ai-msg-bot', true);\n      });\n      frag.appendChild(ssjBanner);\n    }\n    // [추가] 심평원 미등록 장비 배너 — 탭하면 서버 LLM에 물어보는 대신 바로 해당 질문을\n    // 채워서 전송한다(기존 유지보수 알림 배너와 동일한 패턴, get_equipment_list 도구가 이미 지원).\n    if (hiraUnregCount > 0) {\n      var hiraBanner = document.createElement('div');\n      hiraBanner.className = 'ai-alert-banner';\n      hiraBanner.innerHTML = '<i class=\"ti ti-alert-triangle\"></i><span>심평원 미등록 장비 <strong>' + hiraUnregCount + '건</strong>이 있어요. 탭해서 확인하기</span>';\n      hiraBanner.addEventListener('click', function() {\n        if (sending) return;\n        input.value = '심평원 미등록 장비 알려줘';\n        sendMessage();\n      });\n      frag.appendChild(hiraBanner);\n    }\n    if (!frag.childNodes.length) return;\n    if (prepend && messagesEl.firstChild) {\n      messagesEl.insertBefore(frag, messagesEl.firstChild);\n    } else {\n      messagesEl.appendChild(frag);\n    }\n  }\n\n  /* ── 온보딩 메시지 + 추천 버튼 (대화 기록이 전혀 없는 \"진짜 처음\"에만 호출됨) ── */\n  function showOnboarding() {\n    renderAlertBanners(false);\n    bannersRenderedThisLoad = true;\n    var isMobile = !!window.__mobileShell;\n    addMessage(isMobile ? AI_ONBOARDING_TEXT_MOBILE : AI_ONBOARDING_TEXT, 'ai-msg-bot', true);\n    var wrap = document.createElement('div');\n    wrap.className = 'ai-msg-suggestions';\n    var suggestions = (isMobile ? AI_SUGGESTIONS_MOBILE : AI_SUGGESTIONS)\n      .concat(user && user.is_equipment_manager ? AI_SUGGESTIONS_EQUIPMENT_MANAGER : [])\n      .concat(canAccessContracts ? AI_SUGGESTIONS_CONTRACT_OWNER : []);\n    suggestions.forEach(function(s) {\n      var btn = document.createElement('button');\n      btn.type = 'button';\n      btn.className = 'ai-msg-suggestion-btn';\n      btn.textContent = s.label;\n      btn.addEventListener('click', function() {\n        if (sending) return;\n        // [추가] localAction이 있으면 서버로 보내지 않고 클라이언트에서 바로 조회/렌더링한다.\n        if (s.localAction && LOCAL_ACTIONS[s.localAction]) { LOCAL_ACTIONS[s.localAction](); return; }\n        input.value = s.prompt;\n        sendMessage();\n      });\n      wrap.appendChild(btn);\n    });\n    messagesEl.appendChild(wrap);\n    messagesEl.scrollTop = messagesEl.scrollHeight;\n  }\n\n  /* ── 패널을 FAB 근처에 배치(화면 밖으로 안 나가게 방향 자동 전환) ── */\n  function positionPanelNearFab() {\n    var margin = 12;\n    var fabRect = fab.getBoundingClientRect();\n    var panelW = panel.offsetWidth || 360;\n    var panelH = panel.offsetHeight || 480;\n    var vw = window.innerWidth;\n    var vh = window.innerHeight;\n\n    var openUp = (fabRect.top + fabRect.height / 2) > vh / 2;\n    var openLeft = (fabRect.left + fabRect.width / 2) > vw / 2;\n\n    var top = openUp ? (fabRect.top - panelH - margin) : (fabRect.bottom + margin);\n    var left = openLeft ? (fabRect.right - panelW) : fabRect.left;\n\n    top = Math.max(margin, Math.min(top, vh - panelH - margin));\n    left = Math.max(margin, Math.min(left, vw - panelW - margin));\n\n    panel.style.right = 'auto';\n    panel.style.bottom = 'auto';\n    panel.style.top = top + 'px';\n    panel.style.left = left + 'px';\n  }\n\n  function togglePanel(show) {\n    // [추가] 모바일 셸(mobile/app.html)에서는 fab 옆에 작은 팝오버로 띄우는 대신 화면 전체를\n    // 채우는 전용 CSS(.ai-panel-mobile-full, 모바일 셸 자체 스타일)를 쓰므로 좌표 계산이 필요 없다.\n    if (show && !window.__mobileShell) positionPanelNearFab();\n    panel.style.display = show ? 'flex' : 'none';\n    if (show) {\n      setTimeout(function() { input.focus(); }, 50);\n      if (!messagesEl.childNodes.length) {\n        showOnboarding();\n      } else if (!bannersRenderedThisLoad) {\n        // 이전 세션의 대화 기록이 복원되어 이미 메시지가 있는 경우 — showOnboarding()은\n        // 다시 호출되지 않지만, 배너는 이 페이지 로드에서 아직 안 보여줬으므로 최신 알림\n        // 개수 기준으로 맨 위에 붙여준다.\n        renderAlertBanners(true);\n        bannersRenderedThisLoad = true;\n      }\n    }\n  }\n\n  // [추가] 모바일 셸의 하단탭 \"AI어시스턴트\" 항목이 fab을 대신 클릭하는 대신 이 함수를 직접\n  // 호출해서 패널을 연다(모바일 셸에서는 fab 자체를 숨겨두므로 클릭시뮬레이션이 불가능하다).\n  window.aiAssistantOpen = function() { togglePanel(true); };\n  // [추가] 모바일 셸에서 AI 탭이 열려있는 상태로 다른 하단탭(의료장비 등)을 누르면, 패널을\n  // 닫는 절차(X 버튼) 없이 바로 다른 탭으로 넘어가면서 패널이 display:flex인 채로 화면 위에\n  // 그대로 남아있는 버그가 있었다 — 다른 콘텐츠 위에 z-index로 덮여있어 \"탭 내용이 안 보인다\"는\n  // 증상으로 나타난다. mobile-shell.js가 콘텐츠 탭 전환 시마다 이 함수로 패널을 닫도록 한다.\n  window.aiAssistantClose = function() { togglePanel(false); };\n\n  closeBtn.addEventListener('click', function() { togglePanel(false); });\n  newChatBtn.addEventListener('click', function() {\n    interactionId = null;\n    chatHistory = [];\n    clearChatState();\n    messagesEl.innerHTML = '';\n    bannersRenderedThisLoad = false;\n    showOnboarding();\n    input.focus();\n  });\n\n  window.addEventListener('resize', function() {\n    if (panel.style.display !== 'none') positionPanelNearFab();\n  });\n\n  /* ── FAB 드래그 이동 ── */\n  (function setupFabDrag() {\n    var dragging = false;\n    var moved = false;\n    var startX = 0, startY = 0;\n    var origLeft = 0, origTop = 0;\n    var DRAG_THRESHOLD = 6;\n\n    function applyPosition(left, top) {\n      var margin = 4;\n      var maxLeft = window.innerWidth - fab.offsetWidth - margin;\n      var maxTop = window.innerHeight - fab.offsetHeight - margin;\n      left = Math.max(margin, Math.min(left, maxLeft));\n      top = Math.max(margin, Math.min(top, maxTop));\n      fab.style.left = left + 'px';\n      fab.style.top = top + 'px';\n      fab.style.right = 'auto';\n      fab.style.bottom = 'auto';\n      return { left: left, top: top };\n    }\n\n    function restorePosition() {\n      try {\n        var raw = localStorage.getItem(AI_FAB_POS_KEY);\n        if (!raw) return;\n        var pos = JSON.parse(raw);\n        if (typeof pos.left === 'number' && typeof pos.top === 'number') {\n          applyPosition(pos.left, pos.top);\n        }\n      } catch (e) { /* 저장된 위치가 없거나 손상된 경우 기본 위치 사용 */ }\n    }\n\n    function savePosition(left, top) {\n      try { localStorage.setItem(AI_FAB_POS_KEY, JSON.stringify({ left: left, top: top })); } catch (e) { /* 저장 실패는 무시 */ }\n    }\n\n    function onPointerDown(e) {\n      dragging = true;\n      moved = false;\n      fab.setPointerCapture && fab.setPointerCapture(e.pointerId);\n      var rect = fab.getBoundingClientRect();\n      origLeft = rect.left;\n      origTop = rect.top;\n      startX = e.clientX;\n      startY = e.clientY;\n    }\n\n    function onPointerMove(e) {\n      if (!dragging) return;\n      var dx = e.clientX - startX;\n      var dy = e.clientY - startY;\n      if (!moved && (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD)) {\n        moved = true;\n        fab.classList.add('ai-fab-dragging');\n      }\n      if (moved) {\n        applyPosition(origLeft + dx, origTop + dy);\n        if (panel.style.display !== 'none') positionPanelNearFab();\n      }\n    }\n\n    function onPointerUp(e) {\n      if (!dragging) return;\n      dragging = false;\n      fab.classList.remove('ai-fab-dragging');\n      if (moved) {\n        var rect = fab.getBoundingClientRect();\n        savePosition(rect.left, rect.top);\n      } else {\n        // 드래그가 아니라 클릭으로 판단 → 패널 열기/닫기\n        togglePanel(panel.style.display === 'none');\n      }\n      moved = false;\n    }\n\n    fab.addEventListener('pointerdown', onPointerDown);\n    window.addEventListener('pointermove', onPointerMove);\n    window.addEventListener('pointerup', onPointerUp);\n    window.addEventListener('resize', function() {\n      var rect = fab.getBoundingClientRect();\n      if (rect.left && rect.top) applyPosition(rect.left, rect.top);\n    });\n\n    restorePosition();\n  })();\n\n  function handleAction(action) {\n    if (!action || action.type !== 'navigate' || !action.page_key) return;\n    if (typeof window.shellNavigate !== 'function') return;\n    var target = action.page_key;\n    if (action.query_params && typeof action.query_params === 'object') {\n      var qs = Object.keys(action.query_params)\n        .filter(function(k) { return action.query_params[k] != null && action.query_params[k] !== ''; })\n        .map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(action.query_params[k]); })\n        .join('&');\n      if (qs) target += '?' + qs;\n    }\n    window.shellNavigate(target);\n  }\n\n  async function sendMessage() {\n    var text = input.value.trim();\n    if (!text || sending) return;\n    sending = true;\n    input.value = '';\n    sendBtn.disabled = true;\n    addMessage(text, 'ai-msg-user', false);\n    var loadingEl = addMessage('생각 중...', 'ai-msg-loading', false, true);\n\n    try {\n      var { data, error } = await supabaseClient.functions.invoke('ai-assistant', {\n        body: { message: text, previous_interaction_id: interactionId },\n      });\n      loadingEl.remove();\n      if (error) throw error;\n      if (data && data.error) throw new Error(data.error);\n      interactionId = (data && data.interaction_id) || interactionId;\n      addMessage((data && data.reply) || '(응답이 비어있어요)', 'ai-msg-bot', true);\n      if (data && data.action) handleAction(data.action);\n    } catch (e) {\n      loadingEl.remove();\n      addMessage('오류가 발생했어요: ' + (e && e.message ? e.message : String(e)), 'ai-msg-err', false);\n    } finally {\n      sending = false;\n      sendBtn.disabled = false;\n      input.focus();\n    }\n  }\n\n  sendBtn.addEventListener('click', sendMessage);\n  input.addEventListener('keydown', function(e) {\n    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }\n  });\n\n  checkMaintenanceAlerts();\n  checkHiraUnregisteredAlerts();\n  checkContractExpiryAlerts();\n  checkMissingSsjAlerts();\n  restoreChatState(); // 새로고침 전 대화가 있으면 복원 — 없으면 조용히 넘어가고 첫 오픈 시 온보딩이 뜬다.\n}"
