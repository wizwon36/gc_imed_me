          "cookies": [],
          "content": {
            "size": 12167,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\r\n<html lang=\"ko\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>통계</title>\r\n  <link rel=\"stylesheet\" href=\"../../assets/css/common.css\" />\r\n  <link rel=\"stylesheet\" href=\"../../assets/css/pages/statistics.css\" />\r\n  <link rel=\"stylesheet\" href=\"../../assets/font/tabler-icons/tabler-icons.min.css\" />\r\n  <link rel=\"stylesheet\" href=\"../../assets/libs/ag-grid/ag-grid.min.css\" />\r\n  <link rel=\"stylesheet\" href=\"../../assets/libs/ag-grid/ag-theme-alpine.min.css\" />\r\n  <link rel=\"stylesheet\" href=\"../../assets/css/ag-grid-custom.css\" />\r\n  <script>\r\n    if (new URLSearchParams(location.search).get('shell') === '1')\r\n      document.documentElement.classList.add('in-shell');\r\n  </script>\r\n  <style>\r\n    html, body { height:100%; margin:0; background:#f0f2f5; }\r\n    .st-page { display:flex; flex-direction:column; height:100vh; padding:10px; box-sizing:border-box; gap:8px; overflow:hidden; }\r\n    .in-shell .st-page { height:100%; }\r\n    .stat-result-panel { flex:1; min-height:220px; display:flex; flex-direction:column; overflow:hidden; }\r\n    #statsResultGrid { flex:1; min-height:0; height:100%; }\r\n    .stat-chart-table-wrap { display:flex; flex-direction:column; gap:8px; flex:1; min-height:0; }\r\n    .stat-chart-table-wrap.is-compare { flex-direction:row; }\r\n    .stat-chart-table-wrap.is-compare .stat-chart-panel { flex: 0.7; height:auto; min-height:0; }\r\n    .stat-chart-table-wrap.is-compare .stat-result-panel { flex: 1.3; min-height:0; overflow-y:auto; }\r\n  </style>\r\n</head>\r\n<body>\r\n<div class=\"st-page\" id=\"appBody\">\r\n\r\n  <!-- 공통 필터 바 -->\r\n  <div class=\"eq-filter-bar\">\r\n    <span class=\"m-filter-label\">의원</span>\r\n    <select id=\"statDashBranch\">\r\n      <option value=\"\">전체</option>\r\n      <option value=\"강남\">강남의원</option>\r\n      <option value=\"강북\">강북의원</option>\r\n      <option value=\"서울숲\">서울숲의원</option>\r\n    </select>\r\n    <div class=\"m-head-divider\"></div>\r\n    <span class=\"m-filter-label\">시작월</span>\r\n    <input type=\"month\" id=\"statDashYmFrom\">\r\n    <span class=\"m-filter-label\">종료월</span>\r\n    <input type=\"month\" id=\"statDashYmTo\">\r\n    <div class=\"m-head-divider\"></div>\r\n    <span class=\"m-filter-label\">검색구분</span>\r\n    <select id=\"statSearchType\" onchange=\"updateSearchKeywordSuggestions()\">\r\n      <option value=\"vendor\">업체명</option>\r\n      <option value=\"dept\">부서명</option>\r\n      <option value=\"itemType\">자재구분</option>\r\n      <option value=\"itemName\">품목명</option>\r\n      <option value=\"itemCode\">품목코드</option>\r\n    </select>\r\n    <div class=\"stat-filter-field--search\">\r\n      <div class=\"stat-search-box\">\r\n        <i class=\"ti ti-search stat-search-box-icon\" aria-hidden=\"true\"></i>\r\n        <input type=\"text\" id=\"statSearchKeyword\" class=\"stat-search-box-input\" placeholder=\"검색어 입력 (포함된 내용 검색)\" autocomplete=\"off\"\r\n          oninput=\"updateSearchKeywordSuggestions()\"\r\n          onkeydown=\"if(event.key==='Enter'){hideAllSuggestionDropdowns_();runStatsDashboard();}\"\r\n          onblur=\"setTimeout(()=>hideAllSuggestionDropdowns_(), 150)\">\r\n        <div class=\"stat-suggest-dropdown\" id=\"statSearchSuggestions\"></div>\r\n      </div>\r\n    </div>\r\n    <button type=\"button\" class=\"btn btn-sm\" id=\"btnOpenAdvancedSearch\" onclick=\"openAdvancedSearch()\">\r\n      상세검색<span id=\"advancedSearchBadge\" class=\"stat-advanced-badge\" style=\"display:none;\">0</span>\r\n    </button>\r\n    <button type=\"button\" class=\"btn btn-sm\" onclick=\"resetAllSearchConditions()\">초기화</button>\r\n    <button type=\"button\" class=\"btn btn-sm btn-primary\" onclick=\"runStatsDashboard()\">조회</button>\r\n    <div class=\"m-head-divider\"></div>\r\n    <button type=\"button\" class=\"btn btn-sm\" id=\"exportStatsExcelBtn\" onclick=\"exportStatsExcel()\">\r\n      <i class=\"ti ti-download\" aria-hidden=\"true\"></i> 엑셀 다운로드\r\n    </button>\r\n  </div>\r\n\r\n  <!-- 상세검색 패널 (기본 숨김) -->\r\n  <div class=\"stat-advanced-panel\" id=\"advancedSearchPanel\" style=\"display:none;\">\r\n    <div class=\"stat-advanced-header\">\r\n      <strong>상세검색 조건</strong>\r\n      <button type=\"button\" class=\"stat-advanced-close\" onclick=\"closeAdvancedSearch()\">✕</button>\r\n    </div>\r\n    <div id=\"advancedConditionRows\"></div>\r\n    <div class=\"stat-advanced-footer\">\r\n      <button type=\"button\" class=\"btn btn-sm\" onclick=\"addAdvancedConditionRow()\">+ 조건 추가</button>\r\n      <div style=\"flex:1;\"></div>\r\n      <button type=\"button\" class=\"btn btn-sm btn-primary\" onclick=\"applyAdvancedSearch()\">적용</button>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- 입고/사용 구분 (풀폭 메인탭 — equipment/detail.html의 .det-tabs와 동일) -->\r\n  <div class=\"stat-main-tabs\">\r\n    <button class=\"stat-main-tabs-btn active\" id=\"recordTypePurchase\" onclick=\"switchRecordType('purchase')\">입고조회</button>\r\n    <button class=\"stat-main-tabs-btn\" id=\"recordTypeUsage\" onclick=\"switchRecordType('usage')\">사용조회</button>\r\n  </div>\r\n\r\n  <!-- 관점 서브탭 -->\r\n  <div class=\"stat-scope-panel\">\r\n    <div class=\"stat-subtab-underline\">\r\n      <button class=\"stat-subtab-underline-btn active\" id=\"subtabBranch\" onclick=\"switchStatsSubtab('branch')\">의원별</button>\r\n      <button class=\"stat-subtab-underline-btn\" id=\"subtabVendor\" onclick=\"switchStatsSubtab('vendor')\">거래처별</button>\r\n      <button class=\"stat-subtab-underline-btn\" id=\"subtabDept\" onclick=\"switchStatsSubtab('dept')\">부서별</button>\r\n      <button class=\"stat-subtab-underline-btn\" id=\"subtabItem\" onclick=\"switchStatsSubtab('item')\">품목별</button>\r\n      <button class=\"stat-subtab-underline-btn\" id=\"subtabTrend\" onclick=\"switchStatsSubtab('trend')\">기간 비교</button>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- 기간 비교 전용 컨트롤 (기간비교 서브탭에서만 표시) — 서브탭과 별개의 아래 줄, 토글+구간필터 액션바 -->\r\n  <div class=\"eq-filter-bar\" id=\"trendControlsPanel\" style=\"display:none;\">\r\n    <div class=\"stat-seg-toggle\">\r\n      <button class=\"stat-seg-toggle-btn active\" id=\"trendModeMonthly\" onclick=\"switchTrendMode('monthly')\">월별 추이</button>\r\n      <button class=\"stat-seg-toggle-btn\" id=\"trendModeCompare\" onclick=\"switchTrendMode('compare')\">구간 비교</button>\r\n    </div>\r\n\r\n    <div id=\"trendCompareFields\" style=\"display:none; align-items:center; gap:10px;\">\r\n      <span class=\"m-head-divider\"></span>\r\n      <span class=\"stat-trend-compare-label\">기준 구간</span>\r\n      <input type=\"month\" id=\"trendBaseYmFrom\" onchange=\"updateTrendQuickButtonState()\">\r\n      <span style=\"color:var(--text-muted,#9aa5b1);\">~</span>\r\n      <input type=\"month\" id=\"trendBaseYmTo\" onchange=\"updateTrendQuickButtonState()\">\r\n      <span class=\"m-head-divider\"></span>\r\n      <span class=\"stat-trend-compare-label\">비교 구간</span>\r\n      <input type=\"month\" id=\"trendCompareYmFrom\">\r\n      <span style=\"color:var(--text-muted,#9aa5b1);\">~</span>\r\n      <input type=\"month\" id=\"trendCompareYmTo\">\r\n      <div class=\"stat-trend-quick-buttons\">\r\n        <button type=\"button\" class=\"btn btn-sm\" onclick=\"applyTrendQuickRange('prevMonth')\">전월</button>\r\n        <button type=\"button\" class=\"btn btn-sm\" onclick=\"applyTrendQuickRange('prevYear')\">전년 동기</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- 요약 카드 -->\r\n  <div class=\"stat-summary-row\">\r\n    <div class=\"stat-summary-grid\" id=\"statsSummaryGrid\"></div>\r\n  </div>\r\n\r\n  <div class=\"stat-chart-table-wrap\" id=\"statsChartTableWrap\">\r\n    <!-- 기간 비교 그래프 (월별추이/구간비교 탭에서만 표시) -->\r\n    <div class=\"stat-panel stat-chart-panel\" id=\"statsChartPanel\" style=\"display:none;\">\r\n      <canvas id=\"statsTrendChart\"></canvas>\r\n    </div>\r\n\r\n    <!-- 상세 표 -->\r\n    <div class=\"stat-panel stat-result-panel\">\r\n      <div class=\"stat-vat-note-row\">\r\n        <p class=\"stat-vat-note\">※ 자재구분별 금액과 합계금액은 부가세가 포함된 금액입니다. 공급가액은 부가세 별도 금액입니다.</p>\r\n        <button type=\"button\" class=\"btn btn-sm\" id=\"btnVendorRematch\" style=\"display:none;\" onclick=\"openVendorRematchModal()\">\r\n          <i class=\"ti ti-refresh\"></i> 거래처 재매칭\r\n        </button>\r\n      </div>\r\n      <div id=\"statsResultArea\" style=\"flex:1; min-height:0; display:flex; flex-direction:column;\">\r\n        <p style=\"color:var(--text-muted,#7b8794);font-size:13px;\">조회 버튼을 눌러 결과를 확인하세요.</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n</div>\r\n\r\n<!-- 품목 세부내역 모달 -->\r\n<div id=\"itemDetailModal\" class=\"m-modal\">\r\n  <div class=\"m-modal-backdrop\" onclick=\"closeItemDetailModal()\"></div>\r\n  <div class=\"m-modal-dialog m-modal-dialog--wide\">\r\n    <div class=\"m-modal-head\">\r\n      <span class=\"m-modal-title\" id=\"itemDetailModalTitle\">세부 내역</span>\r\n      <button type=\"button\" class=\"m-modal-close\" onclick=\"closeItemDetailModal()\"><i class=\"ti ti-x\"></i></button>\r\n    </div>\r\n    <div class=\"m-modal-body\">\r\n      <div style=\"display:flex; align-items:center; gap:10px; flex-shrink:0;\">\r\n        <div class=\"stat-search-box\" style=\"flex:1;\">\r\n          <i class=\"ti ti-search stat-search-box-icon\" aria-hidden=\"true\"></i>\r\n          <input type=\"text\" id=\"itemDetailModalSearch\" class=\"stat-search-box-input\" placeholder=\"의원, 부서, 공급업체, 규격, LOT 등으로 재검색\" autocomplete=\"off\" oninput=\"filterItemDetailModal()\">\r\n        </div>\r\n      </div>\r\n      <div id=\"itemDetailModalBody\" style=\"flex:1; min-height:0; display:flex; flex-direction:column;\"></div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- 거래처 재매칭(관리자용) 모달 -->\r\n<div id=\"vendorRematchModal\" class=\"m-modal\">\r\n  <div class=\"m-modal-backdrop\" onclick=\"closeVendorRematchModal()\"></div>\r\n  <div class=\"m-modal-dialog\">\r\n    <div class=\"m-modal-head\">\r\n      <span class=\"m-modal-title\">거래처 재매칭</span>\r\n      <button type=\"button\" class=\"m-modal-close\" onclick=\"closeVendorRematchModal()\"><i class=\"ti ti-x\"></i></button>\r\n    </div>\r\n    <div class=\"m-modal-body\">\r\n      <p style=\"font-size:13px; color:var(--text-secondary,#4b5563); line-height:1.6;\">\r\n        마감 처리 시점에 거래처 마스터에 사업자번호가 없었거나 아직 등록 전이어서\r\n        입고/사용 실적에 사업자번호가 비어 있는 채로 저장된 건을 찾아, 현재 거래처\r\n        마스터 기준으로 다시 채워 넣습니다.<br>\r\n        (거래처명이 마스터와 정확히 일치하고, 마스터에 사업자번호가 등록되어 있는 경우만 대상)\r\n      </p>\r\n      <div id=\"vendorRematchPreview\" style=\"margin-top:12px;\"></div>\r\n      <div id=\"vendorRematchResult\" style=\"margin-top:12px; font-size:13px;\"></div>\r\n    </div>\r\n    <div class=\"m-modal-foot\">\r\n      <button type=\"button\" class=\"btn btn-sm\" onclick=\"closeVendorRematchModal()\">닫기</button>\r\n      <button type=\"button\" class=\"btn btn-sm btn-primary\" id=\"btnVendorRematchRun\" onclick=\"runVendorRematch()\">스캔하기</button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<!-- 전역 스피너 -->\r\n<div id=\"globalLoading\" aria-hidden=\"true\">\r\n  <div class=\"global-loading__dialog\">\r\n    <div class=\"global-loading__spinner\" aria-hidden=\"true\"></div>\r\n    <div class=\"global-loading__text\" id=\"globalLoadingText\">불러오는 중...</div>\r\n  </div>\r\n</div>\r\n\r\n<script src=\"https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js\"></script>\r\n<script src=\"../../assets/libs/chart.umd.js\"></script>\r\n<script src=\"../../assets/libs/ag-grid/ag-grid-community.min.js\"></script>\r\n<script src=\"../../assets/libs/supabase.js\"></script>\r\n<script src=\"../../assets/js/core/config.js\"></script>\r\n<script src=\"../../assets/js/core/utils.js\"></script>\r\n<script src=\"../../assets/js/core/supabase.js\"></script>\r\n<script src=\"../../assets/js/core/auth.js\"></script>\r\n<script src=\"../../assets/js/core/permissions.js\"></script>\r\n<script src=\"../../assets/js/management/statistics-client.js\"></script>\r\n<script src=\"../../assets/js/management/statistics.js\"></script>\r\n</body>\r\n</html>"
          },
