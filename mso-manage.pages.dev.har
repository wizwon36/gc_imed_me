          "content": {
            "size": 35240,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>MSO관리팀 업무지원 시스템</title>\n  <script>\n    // [추가] 화면이 좁은 스마트폰에서는 이 데스크톱 화면에 절대 진입하지 못하게 한다 — 태블릿처럼\n    // 화면이 넓은 기기는 정밀 작업이 필요할 때 계속 이 화면을 쓸 수 있어야 하므로, 기기 종류(UA)가\n    // 아니라 \"실제 화면 폭\"으로 판단한다. mso-force-desktop 플래그(mobile-shell.js의 \"데스크톱\n    // 버전으로 보기\" 버튼)나 즐겨찾기·직접 URL 입력으로 들어온 경우 모두 이 가드를 거친다.\n    // 나머지 스크립트/스타일이 로드되기 전, 최대한 이르게 실행해서 데스크톱 화면이 잠깐이라도\n    // 그려지지 않게 한다. 임계값(768px)은 auth.js isNarrowScreen(), mobile-shell.js와 반드시 맞춘다.\n    // [수정] min(width,height) 비교 때문에 일부 PC가 화면폭과 무관하게 모바일로 튕기는 문제가\n    // 있었다 — 자세한 이유는 auth.js의 isNarrowScreen() 주석 참고(요약: 폰의 가로회전 우회 방지가\n    // 목적인데, 그 로직을 마우스 기반 PC에도 그대로 적용하면 흔한 1366×768 해상도에서 브라우저\n    // 툴바 때문에 줄어든 세로 폭까지 \"좁은 화면\"으로 오판하게 된다). auth.js와 동일하게\n    // pointer:coarse(터치가 주 입력)인 기기만 높이까지 같이 보고, PC는 폭만 본다.\n    // [추가] 예전엔 페이지 진입 시점에 딱 한 번만 판단해서, 데스크톱 화면을 이미 열어둔 채로\n    // 창을 계속 줄여도(또는 개발자 도구를 열어 뷰포트가 줄어들어도) 데스크톱 화면이 그대로\n    // 남아있는 문제가 있었다 — 창 크기를 계속 감시하다가 좁아지는 순간 즉시 모바일로 전환한다.\n    // 리사이즈 이벤트는 드래그 중 매우 자주(초당 수십 번) 발생하므로 디바운스로 과도한\n    // 재판단을 막는다.\n    (function () {\n      function isNarrow() {\n        var isTouchPrimary = !!(window.matchMedia && window.matchMedia('(pointer: coarse)').matches);\n        return isTouchPrimary\n          ? Math.min(window.innerWidth, window.innerHeight) < 768\n          : window.innerWidth < 768;\n      }\n      function goMobile() {\n        try { localStorage.removeItem('mso-force-desktop'); } catch (e) {}\n        // [추가] \"화면이 좁아져서 어쩔 수 없이 모바일로 넘어간 것\"이라는 표시를 남겨둔다 —\n        // mobile-shell.js가 이 값을 보고, 나중에 화면이 다시 넓어지면(개발자 도구를 닫는 등)\n        // 자동으로 데스크톱으로 되돌아가게 한다. 반대로 사용자가 직접 mobile/app.html\n        // 주소로 들어오거나 \"데스크톱 버전으로 보기\"에서 다시 모바일로 돌아간 경우는 이 값이\n        // 없으므로, 화면이 넓어도 강제로 데스크톱으로 튕기지 않는다(태블릿에서 일부러 모바일\n        // 화면을 계속 쓰고 싶을 수 있으므로).\n        try { sessionStorage.setItem('mso-mobile-forced-by-width', '1'); } catch (e) {}\n        var base = (location.protocol === 'file:') ? '' : location.origin;\n        location.replace(base + '/mobile/app.html');\n      }\n      try {\n        if (isNarrow()) { goMobile(); return; }\n        var resizeTimer = null;\n        window.addEventListener('resize', function () {\n          clearTimeout(resizeTimer);\n          resizeTimer = setTimeout(function () {\n            try { if (isNarrow()) goMobile(); } catch (e) {}\n          }, 200);\n        });\n      } catch (e) {}\n    })();\n  </script>\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"assets/images/favicon/favicon.ico\">\n  <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"assets/images/favicon/favicon-32x32.png\">\n  <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"assets/images/favicon/favicon-16x16.png\">\n  <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"assets/images/favicon/apple-touch-icon.png\">\n  <link rel=\"stylesheet\" href=\"assets/css/common.css\" />\n  <link rel=\"stylesheet\" href=\"assets/css/shell.css\" />\n  <link rel=\"stylesheet\" href=\"assets/css/ai-assistant.css\" />\n  <link rel=\"stylesheet\" href=\"assets/font/tabler-icons/tabler-icons.min.css\" />\n</head>\n<body>\n\n<div class=\"app-shell\">\n\n  <nav class=\"sidebar\" id=\"sidebar\" role=\"navigation\" aria-label=\"메인 메뉴\">\n    <div class=\"sb-brand\">\n      <div style=\"display:flex;align-items:center;gap:10px;\">\n        <img src=\"assets/images/brand-icon.png\" alt=\"MSO관리팀\" style=\"width:34px;height:34px;border-radius:9px;flex-shrink:0;object-fit:contain;\">\n        <div style=\"text-align:left;line-height:1.25;\">\n          <div style=\"font-size:14px;font-weight:800;color:#ffffff;letter-spacing:-0.01em;\">MSO관리팀</div>\n          <div style=\"font-size:10.5px;font-weight:600;color:rgba(255,255,255,0.55);\">업무지원 시스템</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"sb-user\">\n      <div class=\"sb-user-info\">\n        <div class=\"sb-user-line\" id=\"sbUserLine\">로딩 중...</div>\n        <div class=\"sb-user-role\" id=\"sbUserRole\"></div>\n      </div>\n    </div>\n    <div class=\"sb-nav\">\n\n      <!-- 홈 -->\n      <button class=\"sb-item\" data-page=\"home/home\" onclick=\"navigate('home/home')\" id=\"sbItemHome\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-home\"></i><span>홈</span></div>\n      </button>\n      <div class=\"sb-divider\" style=\"margin:6px 0;\"></div>\n\n      <!-- 의료장비 관리 -->\n      <button class=\"sb-item sb-item-parent\" data-group=\"equipment\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-device-desktop-analytics\"></i><span>의료장비 관리</span></div>\n        <i class=\"ti ti-chevron-right sb-item-arrow\"></i>\n      </button>\n      <div class=\"sb-submenu\" data-group=\"equipment\">\n        <button class=\"sb-sub-item\" data-page=\"equipment/dashboard\" onclick=\"navigate('equipment/dashboard')\">\n          <i class=\"ti ti-layout-dashboard\"></i><span>대시보드</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"equipment/list\" onclick=\"navigate('equipment/list')\">\n          <i class=\"ti ti-list\"></i><span>장비 목록</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"equipment/form\" onclick=\"navigate('equipment/form')\" id=\"sbItemEquipmentForm\">\n          <i class=\"ti ti-plus\"></i><span>장비 등록</span>\n        </button>\n      </div>\n\n      <!-- 자재관리 -->\n      <button class=\"sb-item sb-item-parent\" data-group=\"material\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-box\"></i><span>자재관리</span></div>\n        <i class=\"ti ti-chevron-right sb-item-arrow\"></i>\n      </button>\n      <div class=\"sb-submenu\" data-group=\"material\">\n        <button class=\"sb-sub-item\" data-page=\"materials/purchase-request\" onclick=\"navigate('materials/purchase-request')\" id=\"sbItemPurchaseRequest\">\n          <i class=\"ti ti-shopping-cart\"></i><span>발주요청</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"materials/procurement\" onclick=\"navigate('materials/procurement')\" id=\"sbItemProcurement\" style=\"display:none;\">\n          <i class=\"ti ti-file-invoice\"></i><span>발주 관리</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"materials/stock\" onclick=\"navigate('materials/stock')\" id=\"sbItemStock\" style=\"display:none;\">\n          <i class=\"ti ti-building-warehouse\"></i><span>재고 관리</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"materials/use-stock\" onclick=\"navigate('materials/use-stock')\" id=\"sbItemUseStock\">\n          <i class=\"ti ti-clipboard-check\"></i><span>사용처리</span>\n        </button>\n        <div class=\"sb-divider\"></div>\n        <button class=\"sb-sub-item\" data-page=\"materials/material-stats\" onclick=\"navigate('materials/material-stats')\" id=\"sbItemMaterialStats\">\n          <i class=\"ti ti-chart-bar\"></i><span>자재 통계</span>\n        </button>\n      </div>\n\n      <!-- 사인물 신청 -->\n      <button class=\"sb-item sb-item-parent\" data-group=\"signage\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-rubber-stamp\"></i><span>사인물 신청</span></div>\n        <i class=\"ti ti-chevron-right sb-item-arrow\"></i>\n      </button>\n      <div class=\"sb-submenu\" data-group=\"signage\">\n        <button class=\"sb-sub-item\" data-page=\"signage/apply\" onclick=\"navigate('signage/apply')\" id=\"sbItemSignageApply\">\n          <i class=\"ti ti-pencil\"></i><span>신청</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"signage/history\" onclick=\"navigate('signage/history')\" id=\"sbItemSignageHistory\">\n          <i class=\"ti ti-list-check\"></i><span>신청내역</span>\n        </button>\n      </div>\n\n      <!-- 업무일정 관리 -->\n      <div class=\"sb-divider\" style=\"margin:6px 0;\"></div>\n      <button class=\"sb-item\" data-page=\"task/task-manager\" onclick=\"navigate('task/task-manager')\" id=\"sbItemTask\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-calendar-event\"></i><span>업무일정 관리</span></div>\n      </button>\n\n      <!-- 프로그램 요청 -->\n      <button class=\"sb-item sb-item-parent\" data-group=\"program-request\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-bug\"></i><span>프로그램 요청</span></div>\n        <i class=\"ti ti-chevron-right sb-item-arrow\"></i>\n      </button>\n      <div class=\"sb-submenu\" data-group=\"program-request\">\n        <button class=\"sb-sub-item\" data-page=\"program-request/apply\" onclick=\"navigate('program-request/apply')\" id=\"sbItemProgramRequestApply\">\n          <i class=\"ti ti-pencil\"></i><span>신청</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"program-request/history\" onclick=\"navigate('program-request/history')\" id=\"sbItemProgramRequestHistory\">\n          <i class=\"ti ti-list-check\"></i><span>신청내역</span>\n        </button>\n      </div>\n\n      <!-- 위원회 (위원/회의록 관리 — 전 직원 접근 가능, 등록·수정은 페이지 내부에서 권한별로 제한) -->\n      <button class=\"sb-item\" data-page=\"committee/list\" onclick=\"navigate('committee/list')\" id=\"sbItemCommittee\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-users-group\"></i><span>위원회</span></div>\n      </button>\n\n      <!-- 규정 (위원회와 독립적으로 관리 — N:N으로 위원회에 연결해서 사용) -->\n      <button class=\"sb-item\" data-page=\"regulation/list\" onclick=\"navigate('regulation/list')\" id=\"sbItemRegulation\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-file-text\"></i><span>규정</span></div>\n      </button>\n\n      <!-- 경영관리 -->\n      <div class=\"sb-divider\" style=\"margin:6px 0;\"></div>\n      <button class=\"sb-item sb-item-parent\" data-group=\"management\" id=\"sbGroupManagement\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-chart-infographic\"></i><span>경영관리</span></div>\n        <i class=\"ti ti-chevron-right sb-item-arrow\"></i>\n      </button>\n      <div class=\"sb-submenu\" data-group=\"management\">\n        <button class=\"sb-sub-item\" data-page=\"management/closing\" onclick=\"navigate('management/closing')\" id=\"sbItemClosing\">\n          <i class=\"ti ti-report-money\"></i><span>월마감 자동화</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"management/statistics\" onclick=\"navigate('management/statistics')\" id=\"sbItemStatistics\">\n          <i class=\"ti ti-chart-bar\"></i><span>통계</span>\n        </button>\n      </div>\n\n      <!-- 계약관리 -->\n      <div class=\"sb-divider\" style=\"margin:6px 0;\"></div>\n      <button class=\"sb-item sb-item-parent\" data-group=\"contracts\" id=\"sbGroupContracts\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-contract\"></i><span>계약관리</span></div>\n        <i class=\"ti ti-chevron-right sb-item-arrow\"></i>\n      </button>\n      <div class=\"sb-submenu\" data-group=\"contracts\">\n        <button class=\"sb-sub-item\" data-page=\"contracts/list\" onclick=\"navigate('contracts/list')\" id=\"sbItemContractsList\">\n          <i class=\"ti ti-list\"></i><span>계약목록</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"contracts/form\" onclick=\"navigate('contracts/form')\" id=\"sbItemContractsForm\">\n          <i class=\"ti ti-plus\"></i><span>계약 등록</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"management/sole-source\" onclick=\"navigate('management/sole-source')\" id=\"sbItemSoleSource\">\n          <i class=\"ti ti-file-text\"></i><span>수의계약 사유서</span>\n        </button>\n      </div>\n\n      <!-- 마스터 관리 -->\n      <div class=\"sb-divider sb-admin-only\" id=\"sbDividerMaster\" style=\"display:none;margin:6px 0;\"></div>\n      <button class=\"sb-item sb-item-parent sb-admin-only\" data-group=\"master\" id=\"sbGroupMaster\" style=\"display:none;\">\n        <div class=\"sb-item-inner\"><i class=\"ti ti-settings\"></i><span>마스터 관리</span></div>\n        <i class=\"ti ti-chevron-right sb-item-arrow\"></i>\n      </button>\n      <div class=\"sb-submenu sb-admin-only\" data-group=\"master\">\n        <button class=\"sb-sub-item\" data-page=\"master/org\" onclick=\"navigate('master/org')\" id=\"sbItemMasterOrg\">\n          <i class=\"ti ti-building-hospital\"></i><span>의원·부서·사용자</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"master/supply\" onclick=\"navigate('master/supply')\" id=\"sbItemMasterSupply\">\n          <i class=\"ti ti-package\"></i><span>자재·거래처</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"master/notice\" onclick=\"navigate('master/notice')\" id=\"sbItemMasterNotice\">\n          <i class=\"ti ti-speakerphone\"></i><span>공지사항</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"master/syslog\" onclick=\"navigate('master/syslog')\" id=\"sbItemMasterSyslog\">\n          <i class=\"ti ti-terminal-2\"></i><span>시스템 로그</span>\n        </button>\n        <button class=\"sb-sub-item\" data-page=\"master/ai-requests\" onclick=\"navigate('master/ai-requests')\" id=\"sbItemMasterAiRequests\">\n          <i class=\"ti ti-message-2-bolt\"></i><span>AI 기능요청</span>\n        </button>\n      </div>\n\n    </div>\n    <div class=\"sb-footer\">\n      <div id=\"sbVersionTag\" style=\"font-size:10px;color:var(--sb-text);opacity:0.4;margin-bottom:6px;letter-spacing:0.02em;\"></div>\n      <!-- 모바일에서 \"데스크톱 버전으로 보기\"를 눌러 들어온 경우에만 노출 — 되돌아갈 방법이\n           없으면 계속 데스크톱 화면에 갇히게 되므로 반드시 짝을 맞춰 제공한다. -->\n      <button id=\"sbMobileBtn\" onclick=\"returnToMobile()\" style=\"display:none;width:100%;margin-bottom:6px;\n        background:none;border:1px solid var(--sb-border,rgba(255,255,255,.12));border-radius:7px;cursor:pointer;\n        padding:7px 10px;color:var(--sb-text);font-size:12px;align-items:center;justify-content:center;gap:6px;\">\n        <i class=\"ti ti-device-mobile\" style=\"font-size:14px;\"></i><span>모바일 버전으로 보기</span>\n      </button>\n      <div style=\"display:flex;align-items:center;gap:6px;\">\n        <button class=\"sb-logout\" onclick=\"doLogout()\" style=\"flex:1;\">\n          <i class=\"ti ti-logout\"></i><span>로그아웃</span>\n        </button>\n        <button onclick=\"clearAppCache()\" title=\"캐시 초기화\"\n          style=\"background:none;border:none;cursor:pointer;padding:6px 4px;color:var(--sb-text);opacity:0.5;transition:opacity 0.15s;flex-shrink:0;\"\n          onmouseover=\"this.style.opacity='1'\" onmouseout=\"this.style.opacity='0.5'\">\n          <i class=\"ti ti-refresh\" style=\"font-size:15px;\"></i>\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  <div class=\"sb-overlay\" id=\"sbOverlay\" onclick=\"closeSidebar()\"></div>\n\n  <div class=\"shell-main\">\n    <header class=\"shell-topbar\">\n      <button class=\"shell-topbar-hamburger\" onclick=\"openSidebar()\" aria-label=\"메뉴 열기\">\n        <i class=\"ti ti-menu-2\"></i>\n      </button>\n      <button class=\"shell-sidebar-collapse-btn\" id=\"sidebarCollapseBtn\" onclick=\"toggleSidebarCollapse()\" aria-label=\"사이드바 접기/펼치기\" title=\"사이드바 접기/펼치기\">\n        <i class=\"ti ti-layout-sidebar-left-collapse\" id=\"sidebarCollapseIcon\"></i>\n      </button>\n      <div class=\"shell-breadcrumb\">\n        <span class=\"shell-breadcrumb-app\" id=\"breadcrumbApp\">—</span>\n        <span class=\"shell-breadcrumb-sep\" id=\"breadcrumbSep\" style=\"display:none\">›</span>\n        <span class=\"shell-breadcrumb-page\" id=\"breadcrumbPage\"></span>\n      </div>\n    </header>\n    <div class=\"shell-content\">\n      <iframe class=\"shell-iframe\" id=\"shellFrame\" src=\"\" title=\"콘텐츠 영역\"></iframe>\n    </div>\n  </div>\n\n</div>\n\n<!-- ── AI 어시스턴트 (플로팅 버튼+패널, 모든 페이지에서 접근 가능) ── -->\n<button id=\"aiFab\" class=\"ai-fab\" title=\"AI 어시스턴트 (드래그로 위치 이동 가능)\" aria-label=\"AI 어시스턴트 열기\">\n  <i class=\"ti ti-message-chatbot\"></i>\n  <span id=\"aiFabBadge\" class=\"ai-fab-badge\" style=\"display:none;\">0</span>\n</button>\n<div id=\"aiPanel\" class=\"ai-panel\" style=\"display:none;\">\n  <div class=\"ai-panel-header\" id=\"aiPanelHeader\">\n    <span><i class=\"ti ti-sparkles\"></i> AI 어시스턴트</span>\n    <div style=\"display:flex;gap:4px;\">\n      <button class=\"ai-panel-icon-btn\" id=\"aiNewChatBtn\" title=\"새 대화\"><i class=\"ti ti-plus\"></i></button>\n      <button class=\"ai-panel-icon-btn\" id=\"aiCloseBtn\" title=\"닫기\"><i class=\"ti ti-x\"></i></button>\n    </div>\n  </div>\n  <div class=\"ai-panel-body\" id=\"aiMessages\"></div>\n  <div class=\"ai-panel-footer\">\n    <input type=\"text\" id=\"aiInput\" placeholder=\"메시지를 입력하세요...\" autocomplete=\"off\" />\n    <button id=\"aiSendBtn\" aria-label=\"전송\"><i class=\"ti ti-send\"></i></button>\n  </div>\n</div>\n\n<script src=\"assets/libs/supabase.js\"></script>\n<script src=\"assets/js/core/version.js\"></script>\n  <script src=\"assets/js/core/config.js\"></script>\n<script src=\"assets/js/core/utils.js\"></script>\n<script src=\"assets/js/core/supabase.js\"></script>\n<script src=\"assets/js/core/auth.js\"></script>\n<script src=\"assets/js/core/permissions.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js\"></script>\n<script src=\"assets/js/core/ai-assistant.js\"></script>\n<script>\n'use strict';\n\nconst MENU_META = {\n  'home/home':                 { app: '홈', page: '홈' },\n  'equipment/dashboard': { app: '의료장비 관리', page: '대시보드' },\n  'equipment/list':      { app: '의료장비 관리', page: '장비 목록' },\n  'equipment/form':      { app: '의료장비 관리', page: '장비 등록·수정' },\n  'equipment/detail':    { app: '의료장비 관리', page: '장비 상세' },\n  'task/task-manager':       { app: '업무일정 관리', page: '업무일정·일지' },\n  'committee/list':          { app: '위원회', page: '목록' },\n  'regulation/list':         { app: '규정', page: '목록' },\n  'master/org':             { app: '마스터 관리', page: '의원·부서·사용자' },\n  'master/supply':          { app: '마스터 관리', page: '자재·거래처' },\n  'master/notice':          { app: '마스터 관리', page: '공지사항' },\n  'master/syslog':          { app: '마스터 관리', page: '시스템 로그' },\n  'master/ai-requests':     { app: '마스터 관리', page: 'AI 기능요청' },\n  'management/closing':     { app: '경영관리', page: '월마감 자동화' },\n  'management/sole-source': { app: '계약관리', page: '수의계약 사유서' },\n  'management/statistics':  { app: '경영관리', page: '통계' },\n  'contracts/list':          { app: '계약관리', page: '계약목록' },\n  'contracts/detail':        { app: '계약관리', page: '계약 상세' },\n  'contracts/form':          { app: '계약관리', page: '계약 등록·수정' },\n  'materials/purchase-request':{ app: '자재관리', page: '발주요청' },\n  'materials/use-stock':       { app: '자재관리', page: '사용처리' },\n  'materials/procurement':     { app: '자재관리', page: '발주 관리' },\n  'materials/stock':           { app: '자재관리', page: '재고 관리' },\n  'materials/material-stats':  { app: '자재관리', page: '자재 통계' },\n  'signage/apply':             { app: '사인물 신청', page: '신청' },\n  'signage/history':           { app: '사인물 신청', page: '신청내역' },\n  'program-request/apply':     { app: '프로그램 요청', page: '신청' },\n  'program-request/history':   { app: '프로그램 요청', page: '신청내역' },\n};\n\n/* ── Flyout 서브메뉴 ── */\nlet _flyout = null;\nlet _flyoutTimer = null;\n\nfunction initFlyout() {\n  document.querySelectorAll('.sb-item-parent').forEach(btn => {\n    btn.addEventListener('mouseenter', () => showFlyout(btn));\n    btn.addEventListener('mouseleave', () => scheduleFlyoutClose());\n  });\n  document.addEventListener('click', e => {\n    if (!e.target.closest('.sb-flyout') && !e.target.closest('.sb-item-parent')) hideFlyout();\n  });\n}\n\nfunction showFlyout(btn) {\n  clearTimeout(_flyoutTimer);\n  hideFlyout(true);\n\n  const group   = btn.dataset.group;\n  const submenu = document.querySelector(`.sb-submenu[data-group=\"${group}\"]`);\n  if (!submenu) return;\n  const children = Array.from(submenu.children).filter(el => {\n    if (el.classList.contains('sb-sub-item')) return el.style.display !== 'none';\n    if (el.classList.contains('sb-divider')) return true;\n    return false;\n  });\n  if (!children.some(el => el.classList.contains('sb-sub-item'))) return;\n\n  const fly = document.createElement('div');\n  fly.className = 'sb-flyout';\n  _flyout = fly;\n\n  // 라벨\n  const lbl = document.createElement('div');\n  lbl.style.cssText = 'padding:6px 16px 4px;font-size:10px;font-weight:700;opacity:0.5;text-transform:uppercase;letter-spacing:0.07em;color:#e2e8f0;pointer-events:none;';\n  lbl.textContent = btn.querySelector('span')?.textContent || '';\n  fly.appendChild(lbl);\n\n  children.forEach(item => {\n    if (item.classList.contains('sb-divider')) {\n      const div = document.createElement('div');\n      div.className = 'sb-divider';\n      fly.appendChild(div);\n      return;\n    }\n    const fi = document.createElement('button');\n    fi.className = 'sb-sub-item' + (item.classList.contains('active') ? ' active' : '');\n    fi.innerHTML = item.innerHTML;\n    fi.onclick = () => { item.click(); hideFlyout(); };\n    fly.appendChild(fi);\n  });\n\n  fly.addEventListener('mouseenter', () => clearTimeout(_flyoutTimer));\n  fly.addEventListener('mouseleave', () => scheduleFlyoutClose());\n\n  document.body.appendChild(fly);\n\n  const rect    = btn.getBoundingClientRect();\n  const sidebar = document.querySelector('.sidebar').getBoundingClientRect();\n  fly.style.left = (sidebar.right + 4) + 'px';\n\n  const flyH = fly.offsetHeight;\n  const top  = Math.min(rect.top, window.innerHeight - flyH - 8);\n  fly.style.top = Math.max(8, top) + 'px';\n}\n\nfunction scheduleFlyoutClose() {\n  _flyoutTimer = setTimeout(hideFlyout, 180);\n}\n\nfunction hideFlyout(immediate) {\n  if (immediate) clearTimeout(_flyoutTimer);\n  if (_flyout) { _flyout.remove(); _flyout = null; }\n}\n\n/**\n * 내 계정(user_profiles)의 권한/역할이 바뀌면 즉시 반영되도록 Supabase Realtime으로\n * 감시한다. 본인 row(id=내 uid)만 필터링해서 구독하므로, 다른 사람 권한이 바뀌는 것과는\n * 무관하고 딱 \"지금 로그인한 나\"의 세션에만 영향을 준다.\n * (별도의 프로필 캐시가 있는 게 아니라 auth.getSession()이 매번 DB를 새로 조회하는\n *  구조라, 여기서 할 일은 \"지금 이 페이지가 들고 있는 권한 상태\"를 새로고침해서\n *  다시 읽어오게 하는 것 — 가장 간단하고 확실한 방법은 그냥 새로고침이다.)\n */\nfunction initPermissionRealtimeWatch(user) {\n  if (!user?.id) return;\n  supabaseClient\n    .channel('own-permission-watch-' + user.id)\n    .on('postgres_changes', {\n      event: 'UPDATE',\n      schema: 'mso_manage',\n      table: 'user_profiles',\n      filter: `id=eq.${user.id}`,\n    }, () => {\n      if (typeof showMessage === 'function') {\n        showMessage('권한 정보가 변경되어 화면을 새로고침합니다.', 'info');\n      }\n      setTimeout(() => location.reload(), 800);\n    })\n    .subscribe();\n}\n\ndocument.addEventListener('DOMContentLoaded', async () => {\n  const verEl = document.getElementById('sbVersionTag');\n  if (verEl) verEl.textContent = (typeof APP_VERSION !== 'undefined') ? `v${APP_VERSION}` : '';\n\n  // 모바일 기기에서 \"데스크톱 버전으로 보기\"를 눌러 들어온 경우에만 되돌아가기 버튼을 노출한다\n  // (mso-force-desktop 플래그가 있으면 auth.isMobileDevice()가 항상 false를 반환해 모바일\n  //  기기로 접속해도 계속 데스크톱으로 리다이렉트되므로, 되돌릴 방법이 반드시 있어야 한다).\n  try {\n    if (localStorage.getItem('mso-force-desktop') === '1') {\n      const btn = document.getElementById('sbMobileBtn');\n      if (btn) btn.style.display = 'flex';\n    }\n  } catch (e) {}\n\n  const session = await auth.requireAuth();\n  if (!session) return;\n\n  const user = await auth.getSession();\n  if (user) {\n    const name   = user.user_name || user.email;\n    const clinic = user.clinic_name ? ` · ${user.clinic_name}` : '';\n    document.getElementById('sbUserLine').textContent = name + clinic;\n\n    // 역할 표시 — [★수정] role은 \"전체 의원 조회 scope\"일 뿐 \"시스템 관리자\"가 아닌데\n    // \"관리자\"라고 표시해서 오해를 줬다(home.js와 동일했던 버그). 또한 role 값이\n    // all_clinic/own_clinic으로 바뀌면서 옛 admin/edit/manager/user 매핑은 더 이상\n    // 매치되지 않아 원본 값이 그대로 노출될 뻔했다 — 새 값 기준으로 정리.\n    const roleEl = document.getElementById('sbUserRole');\n    if (roleEl) {\n      roleEl.textContent = '';\n    }\n\n    initAIAssistant(user);\n    initPermissionRealtimeWatch(user);\n\n    // 페이지별 접근 가능 여부 — 공용 PagePerms 모듈(assets/js/core/permissions.js)로 판단한다.\n    // (예전엔 여기 자체적으로 ROLE_DEFAULT_PAGES를 따로 갖고 있었는데, master/org.js의\n    //  사본과 permissions.js의 사본 이렇게 셋이 서로 다른 곳에 중복돼 있었고, 실제로\n    //  master/notice·master/syslog 같은 페이지가 한쪽엔 있고 한쪽엔 빠져있는 등 내용까지\n    //  어긋나 있었다. permissions.js를 유일한 기준으로 삼는다.)\n    const ALL_PAGE_KEYS = Object.keys(MENU_META);\n    const allowedPages = window.PagePerms\n      ? window.PagePerms.getAllowedPages(user, ALL_PAGE_KEYS)\n      : [];\n    allowedPages.push('home/home'); // 홈은 항상 접근 가능 — page_perms 대상이 아님\n    window.__allowedPages = allowedPages; // navigate()에서 직접 URL 진입 막을 때도 재사용\n\n    // data-page를 가진 모든 사이드바 항목에 범용으로 적용 (개별 사용자마다 다를 수 있으므로 하드코딩 대신 권한 목록으로 판단)\n    // [수정] 예전엔 권한 없는 항목도 흐리게+자물쇠로 보여줬는데, 아예 숨기는 방식으로 변경.\n    // [수정] 위원회/규정처럼 하위메뉴 없이 최상위에 단독으로 붙어있는 항목은 클래스가\n    // .sb-sub-item이 아니라 .sb-item이라 이 셀렉터에 안 걸려서, committee/list·regulation/list\n    // 기본값을 접근불가로 잠가놔도 사이드바에서는 계속 보이고 있었다. 서브메뉴 안의\n    // .sb-sub-item과 최상위 단독 .sb-item[data-page]를 둘 다 잡도록 셀렉터를 넓힌다\n    // (.sb-item-parent는 data-page가 없는 그룹 버튼이라 자동으로 제외됨).\n    document.querySelectorAll('.sb-sub-item[data-page], .sb-item[data-page]').forEach(el => {\n      const isAllowed = allowedPages.includes(el.dataset.page);\n      el.style.display = isAllowed ? '' : 'none';\n    });\n    // 확장형(하위메뉴 있는) 그룹 전부 범용 처리 — 하위 항목이 하나도 안 보이면 상위 그룹\n    // 버튼과 서브메뉴, 그 앞의 구분선까지 통째로 숨긴다. [수정] 예전엔 마스터 관리/경영관리\n    // 두 그룹만 하드코딩으로 이렇게 처리하고 있었는데, 의료장비 관리/자재관리/사인물 신청/\n    // 프로그램 요청도 하위 항목 전부 권한이 없으면 빈 화살표 메뉴만 남아있던 문제가 있었다.\n    document.querySelectorAll('.sb-item-parent[data-group]').forEach(groupBtn => {\n      const group = groupBtn.dataset.group;\n      const submenu = document.querySelector(`.sb-submenu[data-group=\"${group}\"]`);\n      if (!submenu) return;\n      const hasVisibleChild = Array.from(submenu.querySelectorAll('.sb-sub-item[data-page]'))\n        .some(el => el.style.display !== 'none');\n      groupBtn.style.display = hasVisibleChild ? '' : 'none';\n      submenu.style.display = hasVisibleChild ? '' : 'none';\n      // 바로 앞 형제가 구분선이면 그것도 같이 숨긴다(그룹 없어졌는데 구분선만 덩그러니 남는 것 방지)\n      const prevDivider = groupBtn.previousElementSibling;\n      if (prevDivider && prevDivider.classList.contains('sb-divider')) {\n        prevDivider.style.display = hasVisibleChild ? '' : 'none';\n      }\n    });\n  }\n\n  const params = new URLSearchParams(location.search);\n  initFlyout();\n  navigate(params.get('page') || 'home/home', true);\n});\n\nfunction navigate(page, tab, skipHistory, extraQuery) {\n  if (!page) return;\n\n  // [추가] 계약목록(contracts/list) 같은 화면이 \"상세/수정 화면에서 뒤로 돌아온 것\"과\n  // \"완전히 다른 메뉴로 이동했다가 다시 들어온 것\"을 구분해 검색조건 유지 여부를 판단할 수\n  // 있도록, 지금 떠나는 페이지가 무엇이었는지 세션에 기록해둔다.\n  try {\n    var _prevPage = (new URLSearchParams(location.search).get('page') || '').split('?')[0];\n    sessionStorage.setItem('gc_imed_nav_from', _prevPage);\n  } catch (e) {}\n\n  const pagePathOnly = page.split('?')[0];\n  if (window.__allowedPages && !window.__allowedPages.includes(pagePathOnly) && pagePathOnly !== 'equipment/detail') {\n    alert('이 페이지에 접근할 권한이 없습니다.');\n    return;\n  }\n\n  // extraQuery 객체가 있으면 쿼리스트링으로 변환해서 page에 합침\n  if (extraQuery && typeof extraQuery === 'object') {\n    var qs = Object.entries(extraQuery).map(function([k, v]) {\n      return encodeURIComponent(k) + '=' + encodeURIComponent(v);\n    }).join('&');\n    if (qs) page = page + '?' + qs;\n  }\n\n  const pagePath  = page.split('?')[0];\n  const pageQuery = page.split('?')[1] || '';\n\n  const meta = MENU_META[pagePath] || { app: pagePath, page: '' };\n  document.getElementById('breadcrumbApp').textContent  = meta.app;\n  document.getElementById('breadcrumbPage').textContent = meta.page;\n  document.getElementById('breadcrumbSep').style.display = meta.page ? '' : 'none';\n\n  const _ver = (typeof APP_VERSION !== 'undefined') ? APP_VERSION : '';\n  const _vq  = _ver ? ('v=' + _ver) : '';\n  const _q   = [pageQuery, _vq].filter(Boolean).join('&');\n  document.getElementById('shellFrame').src =\n    `${CONFIG.SITE_BASE_URL}/pages/${pagePath}.html${_q ? '?' + _q : ''}`;\n\n  document.querySelectorAll('.sb-item.active, .sb-sub-item.active').forEach(el => el.classList.remove('active'));\n  const _activeItem = document.querySelector(`.sb-sub-item[data-page=\"${pagePath}\"]`);\n  if (_activeItem) {\n    _activeItem.classList.add('active');\n    // 부모 그룹 버튼도 active\n    const _group = _activeItem.closest('.sb-submenu')?.dataset.group;\n    if (_group) document.querySelector(`.sb-item-parent[data-group=\"${_group}\"]`)?.classList.add('active');\n  } else {\n    document.querySelector(`.sb-item[data-page=\"${pagePath}\"]`)?.classList.add('active');\n  }\n\n  if (!skipHistory) history.pushState({ page }, '', `?page=${page}`);\n  closeSidebar();\n}\n\nfunction openSidebar() {\n  // [수정] CSS(assets/css/shell.css @media max-width:768px)는 .sidebar.mobile-open /\n  // .sb-overlay.mobile-open 클래스만 인식하는데, 여기서는 계속 is-open/is-visible을\n  // 토글하고 있었다 — 클래스명이 서로 어긋나 있어서 좁은 화면(모바일에서 \"데스크톱\n  // 버전으로 보기\"로 들어온 경우 등)에서 햄버거 버튼을 눌러도 사이드바가 전혀 열리지\n  // 않는 문제였다. CSS 쪽 클래스명에 맞춘다.\n  document.getElementById('sidebar').classList.add('mobile-open');\n  document.getElementById('sbOverlay').classList.add('mobile-open');\n}\nfunction closeSidebar() {\n  document.getElementById('sidebar').classList.remove('mobile-open');\n  document.getElementById('sbOverlay').classList.remove('mobile-open');\n}\n\n/* 데스크탑 전용 — 사이드바 접기/펼치기(화면폭을 더 넓게 쓰고 싶을 때).\n   상태는 localStorage에 저장해서 다음 방문 때도 유지된다. */\nvar SIDEBAR_COLLAPSE_KEY = 'mso-sidebar-collapsed';\nfunction applySidebarCollapse(collapsed) {\n  const sidebar = document.getElementById('sidebar');\n  const icon = document.getElementById('sidebarCollapseIcon');\n  sidebar.classList.toggle('is-collapsed', collapsed);\n  if (icon) icon.className = collapsed ? 'ti ti-layout-sidebar-left-expand' : 'ti ti-layout-sidebar-left-collapse';\n}\nfunction toggleSidebarCollapse() {\n  const collapsed = !document.getElementById('sidebar').classList.contains('is-collapsed');\n  applySidebarCollapse(collapsed);\n  try { localStorage.setItem(SIDEBAR_COLLAPSE_KEY, collapsed ? '1' : '0'); } catch (e) {}\n}\n// 페이지 로드 시 이전 상태 복원\n(function restoreSidebarCollapse() {\n  try {\n    if (localStorage.getItem(SIDEBAR_COLLAPSE_KEY) === '1') applySidebarCollapse(true);\n  } catch (e) {}\n})();\n\nasync function doLogout() { await auth.logout(); }\nfunction returnToMobile() {\n  try { localStorage.removeItem('mso-force-desktop'); } catch (e) {}\n  location.replace(CONFIG.SITE_BASE_URL + '/mobile/app.html');\n}\nfunction clearAppCache() {\n  if (!confirm('캐시를 초기화하고 페이지를 새로고침합니다.')) return;\n  // 현재 페이지 기억\n  var frame = document.getElementById('shellFrame');\n  var currentSrc = frame?.src || '';\n  // 캐시 클리어 후 재로드\n  if ('caches' in window) {\n    caches.keys().then(function(names) {\n      names.forEach(function(name) { caches.delete(name); });\n    });\n  }\n  // iframe 강제 새로고침\n  if (frame && currentSrc) {\n    var sep = currentSrc.includes('?') ? '&' : '?';\n    frame.src = currentSrc + sep + '_t=' + Date.now();\n  }\n  // 전체 페이지 새로고침\n  setTimeout(function() { location.reload(true); }, 100);\n}\n\nwindow.shellNavigate = navigate;\nwindow.addEventListener('popstate', e => {\n  if (e.state?.page) navigate(e.state.page, true);\n});\n</script>\n\n<style>\n  /* 사용자 역할 표시 */\n  .sb-user-role {\n    font-size: 10px;\n    color: rgba(255,255,255,0.4);\n    margin-top: 2px;\n  }\n</style>\n</body>\n</html>"
