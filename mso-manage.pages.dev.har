              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=kMpLbLEF9kpk7TCetUcFzJo54xgPbH9CkIjAeM7YrcTBSEdYkwL%2FxeFrD69pkQsRG1ISIzDZshS4zG5LCvHWkSoA0oFQxLjysQsg%2B0xYgekkraPAGxFGskxOnFD0rW7GueOUoTQKdA%3D%3D\"}]}"
