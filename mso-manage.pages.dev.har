          "cookies": [],
          "content": {
            "size": 1058,
            "mimeType": "application/javascript",
            "text": "/**\n * supabase.js — SDK 초기화 싱글턴\n * app.html(셸)과 iframe 내부 페이지가 동일한 storage key를 사용해\n * 같은 세션을 공유한다.\n *\n * [수정] localStorage → sessionStorage로 변경 — 창(탭)을 닫으면 세션이 무조건\n * 만료되게 하기 위함. sessionStorage는 같은 origin·같은 탭 안에서는 셸과\n * iframe이 그대로 공유하므로(브라우징 컨텍스트 그룹 기준) 기존 공유 방식은\n * 그대로 유지되고, 새 탭/창을 열거나 브라우저를 닫으면 세션이 안 남는다.\n */\n\nconst { createClient } = supabase;\n\nconst supabaseClient = createClient(\n  CONFIG.SUPABASE_URL,\n  CONFIG.SUPABASE_ANON_KEY,\n  {\n    db: {\n      schema: 'mso_manage',   // gc_imed_me 프로젝트 내 MSO관리팀 업무지원 시스템 전용 스키마\n    },\n    auth: {\n      autoRefreshToken: true,\n      persistSession: true,\n      detectSessionInUrl: false,\n      storageKey: 'maneasy-auth',   // 고정 키 — 셸/iframe 공유\n      storage: window.sessionStorage,\n    },\n  }\n);"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": -1,
          "_transferSize": 1027,
          "_error": null,
          "_fetchedViaServiceWorker": false
        },
        "serverIPAddress": "172.66.47.199",
        "startedDateTime": "2026-09-10T01:16:50.632Z",
        "time": 38.20300000006682,
        "timings": {
          "blocked": 8.25100000079279,
          "dns": -1,
